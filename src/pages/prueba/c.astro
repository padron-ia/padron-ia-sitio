        <div class="cta" data-sube>
          <a class="btn" href={WA} target="_blank" rel="noopener"><Fragment set:html={btnIco} /><span>Pide tu revisión gratis</span><span class="btn-tick" aria-hidden="true">✓✓</span></a>
          <span class="cta-nota">O escríbenos a <a href="mailto:hola@padron-ia.es">hola@padron-ia.es</a></span>
        </div>
      </div>
    </section>

    <section class="sec trabajo">
      <div class="wrap">
        <p class="eyebrow" data-sube>Cómo trabajamos</p>
        <h2 class="sec-h" data-sube>Tres pasos, y nos quedamos</h2>
        <ol class="pasos">
          {pasos.map((p, i) => (
            <li class="paso" data-sube>
              <span class="paso-n" aria-hidden="true">{i + 1}</span>
              <h3>{p.t}</h3>
              <p>{p.x}</p>
              <span class="paso-pie">{p.pie}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>


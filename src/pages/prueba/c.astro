      <div class="wrap quien-grid">
        <div class="foto" data-sube>Foto de Jesús</div>
        <div>
          <p class="eyebrow" data-sube>Quién</p>
          <h2 class="sec-h" data-sube>Jesús Martínez Padrón lleva tu negocio contigo.</h2>
          <p class="lead" data-sube>Con nombre, con WhatsApp y sin desaparecer.</p>
          <p class="datos" data-sube>Tus datos, siempre tuyos.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="pie">
    <div class="wrap">
      <span>© 2026 Padrón IA · <a href="mailto:hola@padron-ia.es">hola@padron-ia.es</a></span>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const E = "power3.out"; // the one easing of the page (bubbles and pops use back.out on purpose)
  const $ = (s: string, c: ParentNode = document) => c.querySelector<HTMLElement>(s);
  const $$ = (s: string, c: ParentNode = document) => Array.from(c.querySelectorAll<HTMLElement>(s));

  const escenas = $$("[data-escena]");
  const N = escenas.length;
  const K_ORDEN = 6; // scene 7: the list gets crossed out
  const datos = escenas.map((e) => ({ dia: e.dataset.dia ?? "", hora: e.dataset.hora ?? "", f: Number(e.dataset.fuegos) }));

  // ---------- Top bar: clock with rolling digits + fires counter ----------
  const reloj = $("[data-reloj]")!;
  const rDia = $("[data-dia]")!;
  const rHora = $("[data-hora]")!;
  let horaV = "23:47";
  let diaV = "LUN";
  function setReloj(dia: string, hora: string) {
    if (dia !== diaV) {
      diaV = dia;
      rDia.textContent = dia;
      rDia.hidden = !dia;
      gsap.fromTo(rDia, { opacity: 0, y: -6 }, { opacity: 1, y: 0, duration: 0.4, ease: E });
    }
    if (hora === horaV) return;
    const prev = horaV;
    horaV = hora;
    rHora.textContent = "";
    [...hora].forEach((c, i) => {
      const s = document.createElement("span");
      s.className = c === ":" ? "d dos" : "d";
      s.textContent = c;
      rHora.append(s);
      if (prev[i] !== c) gsap.fromTo(s, { yPercent: 80, rotateX: -90, opacity: 0 }, { yPercent: 0, rotateX: 0, opacity: 1, duration: 0.5, delay: i * 0.035, ease: E });
    });
  }
  const contador = $("[data-contador]")!;
  const cNum = $("[data-fuegos]")!;
  let fuegosV = 0;
  function setFuegos(v: number, orden: boolean) {
    contador.dataset.estado = v > 0 ? "fuego" : orden ? "orden" : "";
    if (v === fuegosV) return;
    fuegosV = v;
    cNum.textContent = String(v);
    gsap.fromTo(cNum, { scale: 1.45 }, { scale: 1, duration: 0.5, ease: "back.out(2)" });
  }

  // ---------- Scene 7: tasks crossed out one by one, each fire goes out with smoke ----------
  const tareas = $$("[data-tarea]");
  const tHecha = tareas.map(() => false);
  function tarea(i: number, on: boolean) {
    if (tHecha[i] === on) return;
    tHecha[i] = on;
    const li = tareas[i];
    const ll = $(".orb", li)!, humo = $(".humo", li)!, raya = $(".raya", li)!, ok = $(".t-ok", li)!;
    li.classList.toggle("hecha", on);
    if (on) {
      gsap.to(ll, { scale: 0, duration: 0.35, ease: E });
      gsap.fromTo(humo, { y: 0, opacity: 0.9, scale: 0.6 }, { y: -26, opacity: 0, scale: 1.3, duration: 0.6, ease: E });
      gsap.to(raya, { scaleX: 1, duration: 0.45, ease: E });
      gsap.to(ok, { opacity: 1, scale: 1, duration: 0.45, ease: "back.out(2)" });
    } else {
      gsap.to(ll, { scale: 1, duration: 0.35, ease: E });
      gsap.set(humo, { opacity: 0 });
      gsap.to(raya, { scaleX: 0, duration: 0.3, ease: E });
      gsap.to(ok, { opacity: 0, scale: 0.4, duration: 0.25, ease: E });
    }
  }

  // ---------- Scene intros (text word by word, then the objects drawn over the illustration) ----------
  const hecho = escenas.map(() => false);
  function intro(k: number) {
    if (hecho[k]) return;
    hecho[k] = true;
    const e = escenas[k];
    const tl = gsap.timeline();
    tl.fromTo($$("[data-w]", e), { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.04, ease: E })
      .fromTo($$("[data-p]", e), { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.7, ease: E }, "-=0.45");
    let d = 0.35;
    $$("[data-obj]", e).forEach((o, i) => {
      switch (o.dataset.obj) {
        case "burbuja":
          tl.fromTo(o, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(2)" }, d);
          d += 0.3;
          break;
        case "fuego":
          tl.fromTo(o, { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.55, ease: "back.out(2)", transformOrigin: "50% 100%" }, d);
          d += 0.22;
          break;
        case "posit":
          tl.fromTo(o, { y: -innerHeight * 0.7, rotation: i % 2 ? 40 : -35, opacity: 1 }, { y: 0, rotation: 0, duration: 0.9, ease: E }, d);
          d += 0.2;
          break;
        case "ticket":
          tl.fromTo(o, { y: -innerHeight * 0.6, rotation: i % 2 ? -30 : 25, opacity: 1 }, { y: 0, rotation: 0, duration: 0.8, ease: E }, d + 0.2);
          d += 0.18;
          break;
        case "circulo":
          tl.set(o, { opacity: 1 }, d)
            .fromTo($("[data-trazo]", o), { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 1, ease: E }, d)
            .fromTo($("[data-num]", o), { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(2)" }, d + 0.6);
          d += 0.4;
          break;
        case "apaga":
          tl.fromTo(o, { opacity: 0, clipPath: "inset(0% 0% 100% 0%)" }, { opacity: 1, clipPath: "inset(0% 0% 0% 0%)", duration: 1.6, ease: E }, d + 0.5);
          break;
        case "chat": {
          const t = $("[data-chat-t]", o)!;
          const txt = t.dataset.txt ?? "";
          const escrito = $(".escrito", t)!;
          const st = { n: 0 };
          tl.fromTo(o, { y: 16, scale: 0.9, opacity: 0 }, { y: 0, scale: 1, opacity: 1, duration: 0.5, ease: "back.out(2)" }, d)
            .to(st, { n: txt.length, duration: txt.length * 0.045, ease: "none", onUpdate: () => { escrito.textContent = txt.slice(0, Math.round(st.n)); } }, d + 0.45)
            .fromTo($("[data-tick2]", o), { opacity: 0, x: -4 }, { opacity: 1, x: 0, duration: 0.3, ease: E }, "+=0.3")
            .add(() => o.classList.add("leido"), "+=0.35");
          break;
        }
        case "aviso":
          tl.fromTo(o, { y: -24, opacity: 0, scale: 0.92 }, { y: 0, opacity: 1, scale: 1, duration: 0.7, ease: "back.out(2)" }, d + 0.4)
            .add(() => o.classList.add("ping"), d + 0.9);
          break;
        case "luz":
          tl.fromTo(o, { opacity: 0, scale: 0.7 }, { opacity: 1, scale: 1.15, duration: 2.6, ease: E }, 0.2);
          break;
      }
    });
    if (k === 4) {
      // Peak: a short shudder once, and the fires orbit slowly.
      const m = $("[data-mueve]", e)!;
      gsap.fromTo(m, { x: -3 }, { x: 3, duration: 0.05, repeat: 5, yoyo: true, ease: "none", delay: 0.2, onComplete: () => { gsap.set(m, { x: 0 }); } });
      $$(".obj .orb", e).forEach((o, i) => {
        gsap.to(o, { rotation: i % 2 ? -360 : 360, duration: 9 + i * 2, repeat: -1, ease: "none" });
        gsap.to($(".orb-i", o), { rotation: i % 2 ? 360 : -360, duration: 9 + i * 2, repeat: -1, ease: "none" });
      });
    }
  }

  // ---------- Active scene: clock, counter, progress dots ----------
  const puntos = $$("[data-punto]");
  let activa = -2;
  function setActiva(k: number) {
    if (k === activa) return;
    activa = k;
    const d = k < 0 ? { dia: "LUN", hora: "23:47", f: 0 } : datos[k];
    setReloj(d.dia, d.hora);
    reloj.classList.toggle("parado", k === N - 1);
    if (k !== K_ORDEN) setFuegos(d.f, k > K_ORDEN);
    else setFuegos(7 - tHecha.filter(Boolean).length, true);
    puntos.forEach((p, i) => {
      p.classList.toggle("activo", i === k);
      p.classList.toggle("pasado", i < k);
    });
    if (k >= 0) intro(k);
    // Looping clips play only while their scene is on screen.
    escenas.forEach((e, i) => {
      const v = e.querySelector<HTMLVideoElement>("[data-video]");
      if (!v) return;
      if (i === k) v.play().catch(() => {});
      else v.pause();
    });
  }

  function main() {
    if (!root.classList.contains("anim")) return; // reduced motion or JS too late: static, readable page

    // Prepare the typed chat bubble (full text stays in the HTML for no-JS readers).
    $$("[data-chat-t]").forEach((t) => {
      const txt = t.textContent ?? "";
      t.dataset.txt = txt;
      t.textContent = "";
      const f = document.createElement("span");
      f.className = "fantasma";
      f.textContent = txt;
      const w = document.createElement("span");
      w.className = "escrito";
      t.append(f, w);
    });
    tareas.forEach((li) => {
      gsap.set($(".raya", li), { scaleX: 0 });
      gsap.set($(".t-ok", li), { opacity: 0, scale: 0.4 });
      gsap.set($(".humo", li), { opacity: 0 });
    });

    // 1 · Loader: papers finish stacking (CSS, ~0.9 s), then the sheet lifts off.
    const carga = $("[data-carga]")!;
    const espera = Math.max(0.1, 0.85 - performance.now() / 1000);
    gsap.timeline({ delay: espera })
      .to(carga, { clipPath: "inset(0% 0% 100% 0%)", duration: 0.35, ease: E })
      .set(carga, { display: "none" });

    // 2 · Cover
    const port = $("[data-portada]")!;
    const t0 = espera + 0.15;
    gsap.timeline({ delay: t0 })
      .fromTo($$("[data-w]", port), { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.04, ease: E })
      .fromTo("[data-subraya]", { strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.8, ease: E }, 0.35)
      .fromTo("[data-badge]", { scale: 0, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(2)" }, 0.7)
      .fromTo($$("[data-port]", port), { y: 24, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.1, ease: E }, 0.3)
      .fromTo("[data-port-fig]", { y: 60, opacity: 0 }, { y: 0, opacity: 1, duration: 0.9, ease: E }, 0.1)
      .add(() => {
        gsap.fromTo("[data-port-fig] img", { scale: 1 }, { scale: 1.015, duration: 3, ease: "sine.inOut", yoyo: true, repeat: -1, transformOrigin: "50% 100%" });
      });

    // 3 · The week: one pinned stage; each scene slowly zooms and drifts, the next one is revealed bottom-up.
    const historia = $("[data-historia]")!;
    ScrollTrigger.create({
      trigger: historia,
      start: "top 55%",
      onEnter: () => setActiva(0),
      onLeaveBack: () => setActiva(-1),
    });

    const mm = gsap.matchMedia();
    mm.add({ mob: "(max-width: 699px)", desk: "(min-width: 700px)" }, (ctx) => {
      const { mob } = ctx.conditions as { mob: boolean };
      const tramo = mob ? 0.9 : 1.2; // viewport heights of scroll per scene
      const tl = gsap.timeline({ defaults: { ease: "none" } });
      escenas.forEach((e, k) => {
        const ini = Math.max(0, k - 0.3);
        const dur = k + 1 - ini;
        // Depth: the background drifts slowly, Laura's layer (cut-out + objects) a bit faster and bigger.
        const p = Number(e.dataset.prof ?? 1);
        tl.fromTo($("[data-fondo]", e), { scale: 1.06, yPercent: 3 }, { scale: 1, yPercent: -3, duration: dur }, ini);
        // Both layers line up exactly mid-scene (k + 0.35, the middle of the reading window), so the copy of Laura
        // still painted in the background never peeks out while the scene is being read.
        tl.fromTo($("[data-frente]", e), { scale: 1.06 + 0.04 * p, yPercent: 3 + 3 * p }, { scale: 1 - 0.04 * p, yPercent: -3 - 3 * p, duration: dur }, ini);
        if (k > 0) tl.fromTo(e, { clipPath: "inset(100% 0% 0% 0%)" }, { clipPath: "inset(0% 0% 0% 0%)", duration: 0.3, ease: E }, k - 0.3);
      });
      // Scene 7 warms up: cold indigo layer fades out while the list is crossed out.
      const fria = $('[data-obj="fria"]', escenas[K_ORDEN]);
      if (fria) tl.fromTo(fria, { opacity: 0.35 }, { opacity: 0, duration: 0.75 }, K_ORDEN + 0.05);

      ScrollTrigger.create({
        trigger: historia,
        pin: true,
        start: "top top",
        end: () => `+=${N * tramo * innerHeight}`,
        scrub: 0.6,
        animation: tl,
        invalidateOnRefresh: true,
        onToggle: (self) => {
          root.classList.toggle("en-historia", self.isActive);
          // Past the end of the story the last clip stops; coming back resumes the active one.
          const v = escenas[activa]?.querySelector<HTMLVideoElement>("[data-video]");
          if (v && !self.isActive && self.progress >= 1) v.pause();
          else if (v && self.isActive) v.play().catch(() => {});
        },
        onUpdate(self) {
          const t = self.progress * N;
          tareas.forEach((_, i) => tarea(i, t >= K_ORDEN + 0.1 + i * 0.11));
          const k = Math.min(N - 1, Math.floor(t + 0.3));
          if (k === K_ORDEN && activa === K_ORDEN) setFuegos(7 - tHecha.filter(Boolean).length, true);
          setActiva(k);
        },
      });
    });

    // Pointer tilt on desktop: Laura's layer up to 3°, the background 1° (depth scenes only).
    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let nx = 0, ny = 0, raf = 0;
      const inclina = () => {
        raf = 0;
        const e = escenas[activa];
        if (!e || !root.classList.contains("en-historia")) return;
        const p = Number(e.dataset.prof ?? 1);
        const f = $("[data-fondo]", e), l = $("[data-frente]", e);
        const o = { duration: 0.6, ease: "power2.out", overwrite: "auto" as const };
        gsap.to(f, { rotationY: nx * 1, rotationX: -ny * 1, ...o });
        if (e.dataset.capa) gsap.to(l, { rotationY: nx * (1 + 2 * p), rotationX: -ny * (1 + 2 * p), ...o });
      };
      addEventListener("pointermove", (ev) => {
        nx = (ev.clientX / innerWidth) * 2 - 1;
        ny = (ev.clientY / innerHeight) * 2 - 1;
        if (!raf) raf = requestAnimationFrame(inclina);
      }, { passive: true });
    }

    // 4 · Close and the sections after it
    const cierre = $("[data-cierre]")!;
    ScrollTrigger.create({
      trigger: cierre,
      start: "top 70%",
      once: true,
      onEnter: () => {
        gsap.fromTo($$("[data-w]", cierre), { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, stagger: 0.06, ease: E });
      },
    });
    $$("[data-sube]").forEach((el) =>
      gsap.fromTo(el, { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.8, ease: E, scrollTrigger: { trigger: el, start: "top 90%", once: true } }),
    );

    setActiva(-1);
    root.classList.add("listo");
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  main();
</script>

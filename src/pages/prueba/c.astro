---
// Prototype C · «La semana de Laura»: illustrated scroll story (comic panels with captions).
// Script: clients/_personal/padron-ia/projects/web-rework/2026-10-29-historia-c-laura.md (OS repo).
import Prueba from "../../layouts/Prueba.astro";
import "./_c.css";

const WA = "https://wa.me/34624664907?text=Hola%2C%20quiero%20la%20revisi%C3%B3n%20gratis%20de%20mi%20negocio";
const fuentes =
  "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Atkinson+Hyperlegible:wght@400;700&display=swap";

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
// Big headings enter word by word: each word is its own inline-block span.
const palabras = (t: string) => t.split(" ").map((w) => `<span class="w" data-w>${esc(w)}</span>`).join(" ");
// Clock digits as spans so the bar can roll the ones that change.
const cifras = (t: string) => [...t].map((c) => `<span class="d${c === ":" ? " dos" : ""}">${esc(c)}</span>`).join("");

type Obj = { t: string; x: string; y: string; txt?: string; m?: false; r?: string; c?: string };
type Escena = {
  img: string; alt: string; dia: string; hora: string; cuando: string; fuegos: number;
  lado: "izq" | "der"; tono: "claro" | "tinta"; movil: "oscuro" | "claro"; cartela?: false;
  lx: number; lxm: number; video?: true; capa?: true; prof?: number; h: string; p?: string; objs: Obj[];
};

// lx / lxm: x of the point to keep in frame (Laura and her objects), as a fraction of the illustration, for the
// overlay layout (it lands at 70 % or 30 % of the screen, opposite the caption) and for the stacked phone layout
// (centred). video: looping clip instead of the still. capa: cut-out of Laura on its own layer (depth parallax);
// prof scales that layer's extra travel down where the cut-out edges would show. Object x/y are % of the illustration.
const escenas: Escena[] = [
  {
    img: "01-noche", dia: "LUN", hora: "23:47", cuando: "Lunes, 23:47", fuegos: 0,
    lado: "izq", tono: "claro", movil: "oscuro", lx: .65, lxm: .66, video: true,
    alt: "Ilustración: de noche, Laura sentada en el sofá mira el móvil con cara de cansancio; en la mesa, el portátil abierto, papeles y una taza.",
    h: "Son las 23:47 y sigue contestando mensajes.",
    p: "Lleva seis años con su negocio. Hace seis años que no desconecta.",
    objs: [
      { t: "burbuja", x: "58%", y: "40%", txt: "1", m: false },
      { t: "burbuja", x: "75%", y: "43%", txt: "4" },
      { t: "burbuja", x: "74%", y: "58%", txt: "9" },
      { t: "burbuja", x: "58%", y: "56%", txt: "14" },
    ],
  },
  {
    img: "02-manana", dia: "MAR", hora: "08:05", cuando: "Martes, 08:05", fuegos: 2,
    lado: "izq", tono: "tinta", movil: "claro", lx: .63, lxm: .70, capa: true, prof: 0.25,
    alt: "Ilustración: por la mañana, Laura cruza su local a toda prisa con un café en una mano y el móvil sonando en la otra, delante de una pared llena de pósits.",
    h: "A las ocho ya va tarde.",
    p: "14 WhatsApps sin leer. Tres son de ayer.",
    objs: [
      { t: "fuego", x: "80%", y: "15%" },
      { t: "fuego", x: "59%", y: "79%" },
      { t: "posit", x: "76%", y: "70%", txt: "Factura", r: "-7deg", c: "#F2F3FB" },
      { t: "posit", x: "46%", y: "26%", txt: "¡Llamar!", r: "6deg", c: "#D9A62E", m: false },
      { t: "posit", x: "45%", y: "50%", txt: "Pedido", r: "-4deg", c: "#8F9BFF", m: false },
    ],
  },
  {
    img: "03-silla", dia: "MAR", hora: "12:40", cuando: "Martes, 12:40", fuegos: 3,
    lado: "der", tono: "tinta", movil: "claro", lx: .42, lxm: .44, capa: true,
    alt: "Ilustración: Laura, de pie y preocupada, mira una silla vacía junto a la pared; detrás, un calendario y unas plantas.",
    h: "Antonio ya no viene.",
    p: "Era cliente de siempre. Nadie se ha dado cuenta de que se fue.",
    objs: [
      { t: "apaga", x: "54.5%", y: "71%" },
      { t: "fuego", x: "47%", y: "48%" },
    ],
  },
  {
    img: "04-papeles", dia: "JUE", hora: "22:15", cuando: "Jueves, 22:15", fuegos: 4,
    lado: "der", tono: "tinta", movil: "oscuro", cartela: false, lx: .46, lxm: .39, capa: true,
    alt: "Ilustración: de noche, Laura se sujeta la frente en su mesa entre montones de papeles y una caja de tickets; a su lado, un calendario con un día rodeado en rojo.",
    h: "El trimestre, otra vez encima.",
    p: "Una caja de tickets para la gestoría y el día 20 en rojo.",
    objs: [
      { t: "fuego", x: "46%", y: "19%" },
      { t: "circulo", x: "53.8%", y: "57.8%" },
      { t: "ticket", x: "56%", y: "76%", r: "-14deg" },
      { t: "ticket", x: "61%", y: "73%", r: "11deg" },
      { t: "ticket", x: "51%", y: "80%", r: "-4deg", m: false },
    ],
  },
  {
    img: "05-cabeza", dia: "VIE", hora: "23:59", cuando: "Viernes, 23:59", fuegos: 7,
    lado: "izq", tono: "claro", movil: "oscuro", lx: .58, lxm: .56, video: true,
    alt: "Ilustración: Laura, con las manos en la cabeza, rodeada de móviles, papeles, mensajes, un calendario y pequeños fuegos que giran a su alrededor.",
    h: "Su día a día es apagar fuegos.",
    p: "Seguimiento, redes, cobros, clientes que se enfrían… Todo en su cabeza.",
    objs: [
      { t: "fuego", x: "52%", y: "40%" },
      { t: "fuego", x: "88%", y: "60%" },
      { t: "fuego", x: "61%", y: "12%" },
    ],
  },
  {
    img: "06-whatsapp", dia: "SÁB", hora: "10:00", cuando: "Sábado, 10:00", fuegos: 7,
    lado: "der", tono: "tinta", movil: "claro", lx: .28, lxm: .30, capa: true,
    alt: "Ilustración: un sábado por la mañana, Laura sonríe sentada en una cafetería junto a la ventana mientras escribe en el móvil; en la mesa, un café y un libro.",
    h: "Un sábado escribió un WhatsApp.",
    p: "30 minutos de conversación. Tres arreglos por escrito en 48 horas.",
    objs: [{ t: "chat", x: "38%", y: "20%", txt: "Hola, quiero la revisión gratis de mi negocio" }],
  },
  {
    img: "07-orden", dia: "Tres semanas", hora: "después", cuando: "Tres semanas después", fuegos: 0,
    lado: "der", tono: "tinta", movil: "claro", lx: .25, lxm: .30, capa: true,
    alt: "Ilustración: Laura, tranquila y con los ojos cerrados, se recuesta en su silla con los brazos cruzados; en la mesa, el portátil muestra un panel ordenado y una planta.",
    h: "Lo pusimos en orden. Uno a uno.",
    objs: [{ t: "fria", x: "50%", y: "50%" }],
  },
  {
    img: "08-vuelve", dia: "Un martes", hora: "cualquiera", cuando: "Un martes cualquiera", fuegos: 0,
    lado: "izq", tono: "tinta", movil: "claro", lx: .62, lxm: .64, capa: true,
    alt: "Ilustración: en la puerta de su local, Laura sonríe y da la mano a un cliente que vuelve, rodeados de macetas con flores.",
    h: "Antonio ha vuelto.",
    p: "Le llegó el mensaje justo a tiempo. Y no es el único.",
    objs: [{ t: "aviso", x: "64%", y: "20%", txt: "Antonio ha reservado" }],
  },
  {
    img: "09-cierre", dia: "", hora: "19:00", cuando: "19:00", fuegos: 0,
    lado: "izq", tono: "tinta", movil: "claro", lx: .60, lxm: .62, video: true,
    alt: "Ilustración: al atardecer, Laura pasea sonriente por una calle de casas blancas con su perro y una bolsa al hombro.",
    h: "Ahora cierra a las siete.",
    p: "Y el domingo es domingo. Su negocio sigue funcionando, en orden.",
    objs: [{ t: "luz", x: "50%", y: "50%" }],
  },
];

const tareas = [
  "Clientes que se van",
  "Recuperar clientes",
  "Seguimiento",
  "Facturas y trimestre",
  "Redes sociales",
  "WhatsApp",
  "Cómo están tus clientes",
];

const pasos = [
  { t: "Revisión del negocio", x: "30 minutos y tres arreglos por escrito en 48 horas.", pie: "Gratis" },
  { t: "Puesta en orden", x: "Precio y plazo cerrados antes de empezar. Pagas por hitos.", pie: "Precio cerrado" },
  { t: "A tu lado", x: "Cuota mensual sin permanencia: lo vigilamos, lo arreglamos y lo mejoramos.", pie: "Sin permanencia" },
];

// Coral flame with a mustard core; .humo is the smoke wisp shown when it goes out.
const llama = `<span class="orb"><span class="orb-i"><svg class="ll" viewBox="0 0 40 52" aria-hidden="true"><path d="M20 1c2 10 14 16 14 31a14 14 0 0 1-28 0c0-8 5-12 7-18 3 5 2 9 5 11 2-7 0-15 2-24Z" fill="#E8664F"/><path d="M20 25c2 5 7 8 7 14a7 7 0 0 1-14 0c0-4 3-6 4-9 1 2 2 3 3 3 0-3-1-5 0-8Z" fill="#F2B544"/></svg></span></span><span class="humo"><i></i><i></i><i></i></span>`;
const btnIco = `<svg class="btn-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>`;
---

<Prueba titulo="Padrón IA · La semana de Laura (prototipo C)" letra="c" fuentes={fuentes}>
  <script is:inline>
    // Animation states only when JS runs and motion is welcome; dropped if the module has not started in 4 s.
    (function () {
      var d = document.documentElement;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      d.classList.add("anim");
      setTimeout(function () { if (!d.classList.contains("listo")) d.classList.remove("anim"); }, 4000);
    })();
  </script>

  <!-- Loader: seven loose papers that stack themselves (CSS only, removed by GSAP) -->
  <div class="carga" data-carga aria-hidden="true">
    <div class="papeles">
      <i style="--i:0;--c:#F2F3FB;--x:-140px;--y:-90px;--r:-38deg;--rf:-4deg"></i>
      <i style="--i:1;--c:#D9A62E;--x:150px;--y:-70px;--r:42deg;--rf:3deg"></i>
      <i style="--i:2;--c:#8F9BFF;--x:-160px;--y:80px;--r:24deg;--rf:-2deg"></i>
      <i style="--i:3;--c:#E8664F;--x:130px;--y:110px;--r:-30deg;--rf:4deg"></i>
      <i style="--i:4;--c:#F2F3FB;--x:-30px;--y:-150px;--r:60deg;--rf:-3deg"></i>
      <i style="--i:5;--c:#D9A62E;--x:40px;--y:150px;--r:-55deg;--rf:2deg"></i>
      <i style="--i:6;--c:#4CB782;--x:0px;--y:-40px;--r:12deg;--rf:0deg"></i>
    </div>
    <p>Lunes, 23:47</p>
  </div>

  <header class="barra">
    <div class="b-marca"><span class="marca">PADRÓN <b>IA</b></span><span class="rotulo">Historia de ejemplo</span></div>
    <div class="reloj" data-reloj aria-hidden="true">
      <span class="r-dia" data-dia>LUN</span>
      <span class="r-hora" data-hora set:html={cifras("23:47")} />
    </div>
    <div class="contador" data-contador aria-hidden="true">
      <span class="c-txt">Fuegos</span><b class="c-num" data-fuegos>0</b>
    </div>
  </header>

  <ol class="progreso" aria-hidden="true">
    {escenas.map((_, i) => <li data-punto><span>{i + 1}</span></li>)}
  </ol>

  <main>
    <!-- 0 · Cover -->
    <section class="portada" data-portada>
      <div class="port-in">
        <div class="port-txt">
          <h1 class="port-h">
            <span class="w" data-w>Esta</span> <span class="w" data-w>es</span>
            <span class="w laura" data-w>Laura.<svg class="subraya" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M4 14C70 6 160 4 296 10" pathLength="1" data-subraya /></svg><span class="badge" data-badge aria-hidden="true">14</span></span>
          </h1>
          <p class="port-p" data-port>Tiene un negocio que funciona. Por eso no para.</p>
          <div class="cta" data-port>
            <a class="btn" href={WA} target="_blank" rel="noopener"><Fragment set:html={btnIco} /><span>Pide tu revisión gratis</span><span class="btn-tick" aria-hidden="true">✓✓</span></a>
            <span class="cta-nota">30 min · 3 arreglos por escrito en 48 h</span>
          </div>
        </div>
        <div class="port-fig" data-port-fig>
          <img src="/prueba/c/laura-de-pie.webp" width="821" height="1100" fetchpriority="high" decoding="async"
            alt="Ilustración: Laura de cuerpo entero, con gafas redondas y chaqueta mostaza, sonríe con el móvil en la mano." />
        </div>
      </div>
      <p class="baja" data-port aria-hidden="true">Baja y conoce su semana<i></i></p>
    </section>

    <!-- 1-9 · The week: one pinned stage, each scene enters like a turned page -->
    <div class="historia" data-historia>
      {escenas.map((e, k) => (
        <section
          class="escena"
          data-escena
          data-k={k}
          data-lado={e.lado}
          data-tono={e.tono}
          data-movil={e.movil}
          data-cartela={e.cartela === false ? "no" : undefined}
          data-dia={e.dia}
          data-hora={e.hora}
          data-fuegos={e.fuegos}
          data-capa={e.capa ? "si" : undefined}
          data-prof={e.prof ?? 0.35}
          style={`--lx:${e.lx};--lxm:${e.lxm}`}
          aria-label={`Escena ${k + 1} de 9: ${e.cuando}`}
        >
          <div class="marco">
            <div class="lienzo">
              <div class="mueve" data-mueve>
                {e.video ? (
                  <video
                    class="fondo"
                    data-fondo
                    data-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    poster={`/prueba/c/${e.img}.webp`}
                    width="1600"
                    height="893"
                    role="img"
                    aria-label={e.alt}
                  >
                    <source src={`/prueba/c/${e.img}.mp4`} type="video/mp4" />
                  </video>
                ) : (
                  <picture class="fondo" data-fondo>
                    <source media="(max-width: 699px)" srcset={`/prueba/c/${e.img}-m.webp`} type="image/webp" />
                    <img
                      src={`/prueba/c/${e.img}.webp`}
                      width="1600"
                      height="893"
                      alt={e.alt}
                      decoding="async"
                      loading={k >= 2 ? "lazy" : undefined}
                      fetchpriority={k === 0 ? "high" : undefined}
                    />
                  </picture>
                )}
                <div class="frente" data-frente>
                {e.capa && (
                  <img class="recorte" src={`/prueba/c/${e.img}-laura.webp`} width="1600" height="893" alt="" decoding="async" loading="lazy" />
                )}
                {e.objs.filter((o) => o.t !== "fria" && o.t !== "luz").map((o) => (
                  <span
                    class={`obj ${o.t}`}
                    data-obj={o.t}
                    data-m={o.m === false ? "no" : undefined}
                    style={`--x:${o.x};--y:${o.y}${o.r ? `;--r:${o.r}` : ""}${o.c ? `;--c:${o.c}` : ""}`}
                    aria-hidden="true"
                  >
                    {o.t === "burbuja" && o.txt}
                    {o.t === "fuego" && <Fragment set:html={llama} />}
                    {o.t === "posit" && o.txt}
                    {o.t === "circulo" && (
                      <Fragment>
                        <svg viewBox="0 0 100 80"><path d="M58 8C30 4 6 18 8 42c2 22 30 32 54 28 22-4 34-20 30-38C88 14 70 6 46 9" pathLength="1" data-trazo /></svg>
                        <b data-num>20</b>
                      </Fragment>
                    )}
                    {o.t === "chat" && (
                      <Fragment>
                        <span class="chat-t" data-chat-t>{o.txt}</span>
                        <span class="chat-pie">10:00 <span class="ticks" data-ticks><i>✓</i><i data-tick2>✓</i></span></span>
                      </Fragment>
                    )}
                    {o.t === "aviso" && (
                      <Fragment>
                        <span class="av-ico"><svg viewBox="0 0 20 20"><path d="M5 10.5l3.2 3.2L15 6.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
                        <span class="av-t"><b>{o.txt}</b><small>Martes · 10:30</small></span>
                      </Fragment>
                    )}
                  </span>
                ))}
                </div>
                {e.objs.filter((o) => o.t === "fria" || o.t === "luz").map((o) => (
                  <span class={`capa-color ${o.t}`} data-obj={o.t} aria-hidden="true" />
                ))}
              </div>
            </div>
          </div>

          <div class="texto">
            <div class="cartela">
              <p class="cuando">{e.cuando}</p>
              <h2 set:html={palabras(e.h)} />
              {e.p && <p class="peq" data-p>{e.p}</p>}
              {k === 6 && (
                <ul class="tareas" data-p>
                  {tareas.map((t) => (
                    <li data-tarea>
                      <span class="t-fuego" aria-hidden="true"><Fragment set:html={llama} /><span class="t-ok">✓</span></span>
                      <span class="t-txt">{t}<span class="raya" aria-hidden="true"></span></span>

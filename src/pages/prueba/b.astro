// Prototype B · «El panel de salidas»: the story of a burnt-out owner who ends up in order.
// Script: clients/_personal/padron-ia/projects/web-rework/2026-10-29-historia-del-autonomo.md (OS repo).
import Prueba from "../../layouts/Prueba.astro";
import "./_b.css";

const WA = "https://wa.me/34624664907?text=Hola%2C%20quiero%20la%20revisi%C3%B3n%20gratis%20de%20mi%20negocio";
const fuentes =
  "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap";

// One flap: static top half (next char), static bottom half (current), falling flap (current top half).
const esc = (c: string) => (c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === '"' ? "&quot;" : c);
const flap = (c: string) => {
  const e = esc(c);
  return `<span class="p" data-p data-ch="${e}" aria-hidden="true"><span class="p-h p-up"><span class="p-c">${e}</span></span><span class="p-h p-dn"><span class="p-c">${e}</span></span><span class="p-h p-up p-fl"><span class="p-c">${e}</span></span></span>`;
};
const fila = (t: string) =>
  t.split(" ").map((w) => `<span class="pw">${[...w].map(flap).join("")}</span>`).join("");
const celdas = (t: string, n: number) => [...t.padEnd(n, " ")].map(flap).join("");
const mini = (t: string) =>
  [...t].map((c) => (c === " " ? " " : `<span class="mini" data-c="${esc(c)}" aria-hidden="true">${esc(c)}</span>`)).join("");
const LLAMA = `<span class="fuego" data-fuego><svg viewBox="0 0 16 22" aria-hidden="true"><path d="M8 1c1 4 6 7 6 13a6 6 0 0 1-12 0c0-3 2-5 3-7 0 2 1 3 2 3C6.6 7 6 4 8 1Z" fill="#E5484D"/><path d="M8 11c.6 2 3 3 3 6a3 3 0 0 1-6 0c0-1.6 1-2.6 1.6-3.4.2 1 .6 1.4 1.1 1.4C7.4 13.5 7.4 12.3 8 11Z" fill="#F5C542"/></svg></span><span class="humo" data-humo></span>`;

// One character per sector. f = feminine plural (las clientas) for articles.
const SECTORES = {
  clinica: { boton: "Clínica", nombre: "Laura", negocio: "su clínica de fisioterapia", uno: "paciente", varios: "pacientes", f: false,
    fuego: "Rosa, paciente de siempre, lleva 40 días sin venir. Nadie se ha dado cuenta." },
  academia: { boton: "Academia", nombre: "Andrés", negocio: "su academia de inglés", uno: "alumno", varios: "alumnos", f: false,
    fuego: "Dos alumnos llevan tres semanas faltando. El mes que viene se darán de baja." },
  taller: { boton: "Taller", nombre: "Toni", negocio: "su taller mecánico", uno: "cliente", varios: "clientes", f: false,
    fuego: "El coche de Juan no ha vuelto a la revisión. Se lo ha llevado a otro taller." },
  comercio: { boton: "Comercio", nombre: "Carmen", negocio: "su tienda de ropa del centro", uno: "clienta", varios: "clientas", f: true,
    fuego: "Lucía, que venía cada temporada, no pisa la tienda desde mayo." },
  online: { boton: "Tienda online", nombre: "Marta", negocio: "su tienda online de cosmética", uno: "clienta", varios: "clientas", f: true,
    fuego: "300 clientas compraron una vez y no han vuelto." },
  alojamiento: { boton: "Alojamiento", nombre: "Pilar", negocio: "sus casas rurales", uno: "huésped", varios: "huéspedes", f: false,
    fuego: "Los de Bilbao venían cada verano. Este año no han reservado." },
};
type Sector = (typeof SECTORES)["clinica"];
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const vars = (s: Sector): Record<string, string> => {
  const los = `${s.f ? "las" : "los"} ${s.varios}`;
  const un = `${s.f ? "una" : "un"} ${s.uno}`;
  return { nombre: s.nombre, negocio: s.negocio, los, Los: cap(los), un, Un: cap(un), Cada: `Cada ${s.uno}`, fuego: s.fuego };
};
const fill = (t: string, v: Record<string, string>) => t.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? "");
const V0 = vars(SECTORES.clinica);

const PROLOGO = "{nombre} abrió {negocio} hace seis años. Le va bien. Por eso no para: son las 23:47 de un lunes y sigue contestando mensajes desde el sofá. Su día a día es apagar fuegos.";
const EPILOGO = "{nombre} abre {negocio} con el café. El panel, en verde. Cierra a las siete y el domingo es domingo. {Los} que se iban, vuelven; el trimestre ya no le pilla.";

const capitulos = [
  { h: "MAR 09:10", dia: "martes", p: "Clientes que se van", antes: "{fuego}", despues: "Ahora el aviso le llega a tiempo, antes de perderlos.", e: "AVISADO", tono: "amar" },
  { h: "MAR 13:30", dia: "martes", p: "Recuperar clientes", antes: "«Habría que escribir a {los} de antes…» Lleva meses pensándolo.", despues: "Les llega un mensaje en el momento justo. Esta semana han vuelto tres.", e: "EN CAMINO", tono: "amar" },
  { h: "MIÉ 18:45", dia: "miércoles", p: "Seguimiento", antes: "{Un} preguntó el jueves y nadie le contestó.", despues: "{Cada} tiene su siguiente paso. Nadie se queda sin respuesta.", e: "EN HORA", tono: "verde" },
  { h: "JUE 22:15", dia: "jueves", p: "Facturas y trimestre", antes: "Una caja de tickets para la gestoría y el día 20 encima.", despues: "Las facturas salen solas. El trimestre llega preparado.", e: "HECHO", tono: "verde" },
  { h: "VIE 16:00", dia: "viernes", p: "Redes sociales", antes: "Última publicación: hace cinco semanas.", despues: "Las publicaciones del mes, preparadas y programadas.", e: "PROGRAMADO", tono: "verde" },
  { h: "SÁB 00:40", dia: "sábado", p: "WhatsApp", antes: "14 mensajes sin leer. Tres son de ayer.", despues: "Contesta al momento, a cualquier hora, y le pasa lo importante.", e: "EN HORA", tono: "verde" },
  { h: "DOM 20:00", dia: "domingo", p: "Cómo están tus clientes", antes: "Todo está en su cabeza. Y su cabeza no descansa.", despues: "Un panel: quién está bien, quién se enfría, quién debe.", e: "AL DÍA", tono: "verde" },
];
const estadoTxt = (e: string) => cap(e.toLowerCase());

const tramos = [
  { n: "Tramo 1", t: "Revisión del negocio", x: "30 minutos y tres arreglos por escrito en 48 horas.", pie: "Gratis" },
  { n: "Tramo 2", t: "Puesta en orden", x: "Precio y plazo cerrados antes de empezar. Pagas por hitos, según lo ves funcionando.", pie: "Precio cerrado" },
  { n: "Tramo 3", t: "A tu lado", x: "Cuota mensual sin permanencia: lo vigilamos, lo arreglamos y lo mejoramos.", pie: "Sin permanencia" },
];

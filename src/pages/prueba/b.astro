<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const ANIM = root.classList.contains("anim");
  const STEP = 0.045; // seconds per character
  const POOL = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const LOW = "abcdefghijklmnopqrstuvwxyz";
  const rnd = () => POOL[(Math.random() * POOL.length) | 0];
  const rint = (a: number, b: number) => a + ((Math.random() * (b - a + 1)) | 0);
  const $$ = (s: string, c: ParentNode = document) => Array.from(c.querySelectorAll<HTMLElement>(s));
  const $ = (s: string, c: ParentNode = document) => c.querySelector<HTMLElement>(s)!;
  const ch = (p: HTMLElement) => p.getAttribute("data-ch") ?? " ";

  // ---------- Split-flap engine ----------
  type Faces = { up: HTMLElement; dn: HTMLElement; fl: HTMLElement; flap: HTMLElement };
  type Flap = HTMLElement & { _f?: Faces; _c?: string; _tl?: gsap.core.Timeline };
  const flaps = (s: string, c: ParentNode = document) => $$(s, c) as Flap[];

  function faces(p: Flap): Faces {
    if (!p._f) {
      const c = $$(".p-c", p);
      p._f = { up: c[0], dn: c[1], fl: c[2], flap: $(".p-fl", p) };
      p._c = c[1].textContent ?? " ";
    }
    return p._f;
  }
  function setChar(p: Flap, c: string) {
    const f = faces(p);
    p._tl?.kill();
    f.up.textContent = f.dn.textContent = f.fl.textContent = c;
    p._c = c;
    gsap.set(f.flap, { rotateX: 0 });
  }
  // Flip through n characters (n-1 random + final). The top half falls 0 → -90 revealing the next one.
  function spin(p: Flap, final: string, n: number, delay = 0) {
    if (!ANIM) return setChar(p, final);
    const f = faces(p);
    if (p._c === final && !p._tl?.isActive()) return;
    p._tl?.kill();
    const tl = gsap.timeline({ delay });
    let cur = p._c ?? " ";
    const seq: string[] = [];
    for (let i = 0; i < n - 1; i++) seq.push(rnd());
    seq.push(final);
    for (const next of seq) {
      const prev = cur;
      tl.call(() => {
        f.up.textContent = next;
        f.fl.textContent = prev;
        f.dn.textContent = prev;
        p._c = next;
        gsap.set(f.flap, { rotateX: 0 });
      })
        .to(f.flap, { rotateX: -90, duration: STEP, ease: "power1.in" })
        .call(() => { f.dn.textContent = next; });
      cur = next;
    }
    tl.call(() => { f.fl.textContent = final; gsap.set(f.flap, { rotateX: 0 }); });
    p._tl = tl;
  }
  // Spin a row of flaps to a text (padded to the row length).
  function spinText(cells: Flap[], text: string, min = 4, max = 8, stagger = 0.04) {
    const t = text.padEnd(cells.length, " ");
    cells.forEach((p, i) => spin(p, t[i], rint(min, max), i * stagger));
  }
  // Text "flip": reveals the target left to right through random letters.
  function scramble(el: HTMLElement & { _t?: gsap.core.Tween }, to: string, dur = 0.6, delay = 0) {
    el._t?.kill();
    if (!ANIM) { el.textContent = to; return; }
    const from = el.textContent ?? "";
    const o = { p: 0 };
    el._t = gsap.to(o, {
      p: 1, duration: dur, delay, ease: "none",
      onUpdate() {
        const n = Math.floor(o.p * to.length);
        const len = Math.round(from.length + (to.length - from.length) * o.p);
        let s = to.slice(0, n);
        for (let i = n; i < len; i++) s += to[i] === " " ? " " : LOW[(Math.random() * LOW.length) | 0];
        el.textContent = s;
      },
      onComplete() { el.textContent = to; },
    });
  }

  // ---------- Story data (single source: the JSON the page renders from) ----------
  type Sector = { boton: string; nombre: string; negocio: string; uno: string; varios: string; f: boolean; fuego: string };
  const SECT = JSON.parse($("[data-sectores]").textContent || "{}") as Record<string, Sector>;
  const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
  const vars = (s: Sector): Record<string, string> => {
    const los = `${s.f ? "las" : "los"} ${s.varios}`;
    const un = `${s.f ? "una" : "un"} ${s.uno}`;
    return { nombre: s.nombre, negocio: s.negocio, los, Los: cap(los), un, Un: cap(un), Cada: `Cada ${s.uno}`, fuego: s.fuego };
  };
  const fill = (t: string, v: Record<string, string>) => t.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? "");
  const KEY = "padron-b-sector";
  let sector = "clinica";
  try { const g = localStorage.getItem(KEY); if (g && SECT[g]) sector = g; } catch { /* storage blocked */ }
  let V = vars(SECT[sector]);

  // ---------- Chapters board state ----------
  const sal = $("[data-salidas]");
  const lineas = $$("[data-linea]", sal);
  const billetes = $$("[data-billete]", sal);
  const orden = lineas.map(() => !ANIM); // static page = everything already in order
  const textoQ = (i: number) => fill((orden[i] ? lineas[i].dataset.despues : lineas[i].dataset.antes) ?? "", V);

  function aplicar(key: string, animar: boolean) {
    sector = key;
    V = vars(SECT[key]);
    $$("[data-tpl]").forEach((el) => { el.textContent = fill(el.dataset.tpl ?? "", V); });
    lineas.forEach((l, i) => {
      const q = $("[data-q]", l) as HTMLElement & { _t?: gsap.core.Tween };
      if (animar) scramble(q, textoQ(i), 0.5); else { q._t?.kill(); q.textContent = textoQ(i); }
    });
    const nombre = V.nombre.toUpperCase();
    $$("[data-nombre]").forEach((row) => {
      if (row.hasAttribute("role")) row.setAttribute("aria-label", V.nombre);
      const cells = flaps("[data-p]", row);
      if (animar) spinText(cells, nombre, 5, 9); else nombre.padEnd(6, " ").split("").forEach((c, i) => setChar(cells[i], c));
    });
    $$("[data-sector]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sector === key)));
  }
  aplicar(sector, false);
  $$("[data-sector]").forEach((b) =>
    b.addEventListener("click", () => {
      const k = b.dataset.sector ?? "clinica";
      if (k === sector) return;
      try { localStorage.setItem(KEY, k); } catch { /* storage blocked */ }
      aplicar(k, true);
    }),
  );

  // Real clock of the visitor (HH:MM); flips the cells that change.
  function startClock() {
    const cells = flaps("[data-reloj] [data-p]");
    let last = "";
    const tick = () => {
      const d = new Date();
      const h = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
      if (h === last) return;
      [...h].forEach((c, i) => { if (last[i] !== c) spin(cells[i], c, last ? rint(2, 4) : rint(5, 8), last ? 0 : i * 0.04); });
      last = h;
    };
    tick();
    setInterval(tick, 1000);
  }

  function main() {
    if (!ANIM) {
      startClock(); // reduced motion or JS too late: static, ordered page
      return;
    }

    // Loader: 8 flaps settle on «EN ORDEN», then the board opens (≈1.15 s)
    const carga = $("[data-carga]");
    let fin = 0;
    flaps("[data-p]", carga).forEach((p, i) => {
      setChar(p, rnd());
      const n = rint(6, 9), d = 0.04 + i * 0.04;
      spin(p, ch(p), n, d);
      fin = Math.max(fin, d + n * STEP);
    });
    const abre = fin + 0.08;
    gsap.timeline({ delay: abre })
      .to(carga.querySelector(".fila"), { opacity: 0, duration: 0.15, ease: "power3.out" })
      .to("[data-carga-a]", { yPercent: -100, duration: 0.36, ease: "power3.inOut" }, 0.04)
      .to("[data-carga-b]", { yPercent: 100, duration: 0.36, ease: "power3.inOut" }, 0.04)
      .set(carga, { display: "none" });

    // Hero: two rows flip in, 40 ms stagger left to right
    $$("[data-hero] [data-fila]").forEach((row, r) => {
      flaps("[data-p]", row).forEach((p, i) => {
        setChar(p, rnd());
        spin(p, ch(p), rint(6, 12), abre + 0.1 + r * 0.14 + i * 0.04);
      });
    });
    gsap.fromTo("[data-hero-sub]", { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", stagger: 0.1, delay: abre + 0.35 });
    startClock();

    // Button micro-interaction: the label does a short flap flip on hover/focus
    $$("[data-mini]").forEach((btn) => {
      const letters = $$(".mini", btn);
      let busy = false;
      const go = () => {
        if (busy) return;
        busy = true;
        letters.forEach((s) => { if (!s.style.width) s.style.width = `${s.getBoundingClientRect().width}px`; });
        const tl = gsap.timeline({ onComplete: () => { busy = false; } });
        letters.forEach((s, i) => {
          const c = s.dataset.c ?? "";
          if (!/[A-Za-zÁÉÍÓÚÑáéíóúñ]/.test(c)) return;
          const t = i * 0.02;
          tl.to(s, { rotateX: -90, duration: 0.07, ease: "power1.in" }, t)
            .call(() => { s.textContent = rnd(); }, undefined, t + 0.07)
            .fromTo(s, { rotateX: 90 }, { rotateX: 0, duration: 0.07, ease: "power3.out", immediateRender: false }, t + 0.07)
            .to(s, { rotateX: -90, duration: 0.06, ease: "power1.in" }, t + 0.15)
            .call(() => { s.textContent = c; }, undefined, t + 0.21)
            .fromTo(s, { rotateX: 90 }, { rotateX: 0, duration: 0.12, ease: "power3.out", immediateRender: false }, t + 0.21);
        });
      };
      btn.addEventListener("mouseenter", go);
      btn.addEventListener("focus", go);
    });

    // Headings and blocks rise in
    $$("[data-sube]").forEach((el) =>
      gsap.to(el, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 88%", once: true } }),
    );

    // Prologue: the clock lands on LUN 23:47 and the fire counter on 7
    const pro = $("[data-prologo]");
    const proCells = flaps("[data-pro-reloj] [data-p]", pro);
    const proCont = flaps(".contador [data-p]", pro);
    proCells.forEach((p) => setChar(p, " "));
    proCont.forEach((p) => setChar(p, " "));
    ScrollTrigger.create({
      trigger: pro, start: "top 75%", once: true,
      onEnter() {
        proCells.forEach((p, i) => spin(p, ch(p), rint(6, 12), i * 0.04));
        spin(proCont[0], "7", 8, 0.5);
      },
    });

    // Chapters: every line starts RETRASADO with a fire; scroll puts them in order one by one
    const RET = "RETRASADO";
    const semana = flaps("[data-semana] [data-p]", sal);
    const contador = flaps("[data-contador] [data-p]", sal)[0];
    const fuegosBox = $("[data-fuegos]", sal);
    const horas = ["LUN 23:47", ...lineas.map((l) => $(".s-h", l).textContent ?? "")];
    semana.forEach((p, i) => setChar(p, horas[0][i] ?? " "));
    setChar(contador, "7");
    lineas.forEach((l, i) => {
      l.classList.remove("on");
      $("[data-q]", l).textContent = textoQ(i);
      flaps("[data-p]", $("[data-e]", l)).forEach((p, k) => setChar(p, RET.padEnd(10, " ")[k]));
    });
    const ordenar = (i: number, on: boolean) => {
      if (orden[i] === on) return;
      orden[i] = on;
      const l = lineas[i];
      l.classList.toggle("on", on);
      spinText(flaps("[data-p]", $("[data-e]", l)), on ? l.dataset.estado ?? "" : RET, 6, 10);
      scramble($("[data-q]", l), textoQ(i), 0.55);
      const fuego = $("[data-fuego]", l), humo = $("[data-humo]", l);
      gsap.killTweensOf([fuego, humo]);
      if (on) {
        // Fire out: flame shrinks, a thread of smoke rises and fades (0.6 s)
        gsap.to(fuego, { scale: 0, duration: 0.3, ease: "power1.in" });
        gsap.timeline()
          .fromTo(humo, { opacity: 0, y: 0, scaleY: 0.4 }, { opacity: 0.85, y: -8, scaleY: 1, duration: 0.25, ease: "power3.out" }, 0.15)
          .to(humo, { opacity: 0, y: -26, scaleY: 1.4, duration: 0.35, ease: "power1.in" });
      } else {
        gsap.set(humo, { opacity: 0 });
        gsap.to(fuego, { scale: 1, duration: 0.35, ease: "power3.out" });
      }
    };
    let activa = -2;
    const activar = (k: number) => {
      if (k === activa) return;
      activa = k;
      lineas.forEach((l, j) => l.classList.toggle("activa", j === k));
      billetes.forEach((b) => b.classList.remove("vis"));
      const b = billetes[k + 1];
      b.classList.add("vis");
      gsap.fromTo(b, { opacity: 0, y: 18, rotate: k % 2 ? 1.2 : -1.2 }, { opacity: 1, y: 0, rotate: 0, duration: 0.5, ease: "power3.out" });
      // The week clock walks to the chapter time, the counter goes down 7 → 0
      const h = horas[k + 1];
      semana.forEach((p, i) => spin(p, h[i] ?? " ", rint(3, 6), i * 0.03));
      const quedan = 6 - k;
      spin(contador, String(quedan), 4);
      fuegosBox.classList.toggle("cero", quedan === 0);
    };

    const mm = gsap.matchMedia();
    mm.add({ mob: "(max-width: 760px)", desk: "(min-width: 761px)" }, (ctx) => {
      const { mob } = ctx.conditions as { mob: boolean };
      const tramo = mob ? 0.6 : 0.8; // viewport heights per chapter
      const tl = gsap.timeline().fromTo("[data-barra]", { scaleX: 0 }, { scaleX: 1, ease: "none" });
      ScrollTrigger.create({
        trigger: $("[data-pin]", sal),
        pin: true,
        start: "top top",
        end: () => `+=${7 * innerHeight * tramo}`,
        scrub: 0.6,
        animation: tl,
        invalidateOnRefresh: true,
        onUpdate(self) {
          let k = -1;
          for (let i = 0; i < 7; i++) if (self.progress >= (i + 0.3) / 7.3) k = i;
          lineas.forEach((_, i) => ordenar(i, i <= k));
          activar(k);
        },
      });
    });
    activar(-1);

    // Epilogue: the whole board turns green, clock at LUN 08:00
    const epi = $("[data-epilogo]");
    const epiPanel = $("[data-epi-panel]", epi);
    const epiReloj = flaps("[data-epi-reloj] [data-p]", epi);
    epiPanel.classList.remove("verde");
    epiReloj.forEach((p) => setChar(p, " "));
    const epiLin = $$(".epi-lin", epi);
    epiLin.forEach((l) => flaps("[data-p]", l).forEach((p, k) => setChar(p, RET.padEnd(10, " ")[k])));
    ScrollTrigger.create({
      trigger: epiPanel, start: "top 72%", once: true,
      onEnter() {
        epiReloj.forEach((p, i) => spin(p, ch(p), rint(6, 10), i * 0.04));
        epiLin.forEach((l, li) => flaps("[data-p]", l).forEach((p, i) => spin(p, ch(p), rint(6, 10), 0.2 + li * 0.08 + i * 0.03)));
        gsap.delayedCall(0.45, () => epiPanel.classList.add("verde"));
      },
    });

    // Cómo trabajamos: route line draws with the scroll; each stop lights up as the line reaches it
    const trabajo = $("[data-trabajo]");
    const tramos = $$("[data-tramo]", trabajo);
    gsap.timeline({
      scrollTrigger: {
        trigger: $(".billete-largo", trabajo),
        start: "top 72%",
        end: "bottom 50%",
        scrub: 0.6,
        onUpdate(self) {
          [0.02, 0.4, 0.78].forEach((u, i) => tramos[i].classList.toggle("on", self.progress >= u));
        },
      },
    }).fromTo($$("[data-ruta]", trabajo), { strokeDashoffset: 1 }, { strokeDashoffset: 0, ease: "none" });

    // Closing board flips to «¿LO PONEMOS EN ORDEN?»
    const final = $("[data-final]");
    flaps("[data-fila] [data-p]", final).forEach((p) => setChar(p, " "));
    ScrollTrigger.create({
      trigger: $(".final-panel", final),
      start: "top 70%",
      once: true,
      onEnter() {
        $$("[data-fila]", final).forEach((row, r) =>
          flaps("[data-p]", row).forEach((p, i) => spin(p, ch(p), rint(6, 12), r * 0.15 + i * 0.04)),
        );
      },
    });

    root.classList.add("listo");
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  main();
</script>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const STEP = 0.045; // seconds per character
  const POOL = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  const LOW = "abcdefghijklmnopqrstuvwxyz";
  const rnd = () => POOL[(Math.random() * POOL.length) | 0];
  const rint = (a: number, b: number) => a + ((Math.random() * (b - a + 1)) | 0);
  const $$ = (s: string, c: ParentNode = document) => Array.from(c.querySelectorAll<HTMLElement>(s));
  const ch = (p: HTMLElement) => p.getAttribute("data-ch") ?? " ";

  type Faces = { up: HTMLElement; dn: HTMLElement; fl: HTMLElement; flap: HTMLElement };
  type Flap = HTMLElement & { _f?: Faces; _c?: string; _tl?: gsap.core.Timeline };

  function faces(p: Flap): Faces {
    if (!p._f) {
      const c = $$(".p-c", p);
      p._f = { up: c[0], dn: c[1], fl: c[2], flap: p.querySelector(".p-fl") as HTMLElement };
      p._c = c[1].textContent ?? " ";
    }
    return p._f;
  }
  function setChar(p: Flap, c: string) {
    const f = faces(p);
    p._tl?.kill();
    f.up.textContent = f.dn.textContent = f.fl.textContent = c;
    p._c = c;
    gsap.set(f.flap, { rotateX: 0 });
  }
  // Flip through n characters (n-1 random + final). Top half falls 0 → -90 revealing the next one.
  function spin(p: Flap, final: string, n: number, delay = 0) {
    const f = faces(p);
    p._tl?.kill();
    const tl = gsap.timeline({ delay });
    let cur = p._c ?? " ";
    const seq: string[] = [];
    for (let i = 0; i < n - 1; i++) seq.push(rnd());
    seq.push(final);
    for (const next of seq) {
      const prev = cur;
      tl.call(() => {
        f.up.textContent = next;
        f.fl.textContent = prev;
        f.dn.textContent = prev;
        p._c = next;
        gsap.set(f.flap, { rotateX: 0 });
      })
        .to(f.flap, { rotateX: -90, duration: STEP, ease: "power1.in" })
        .call(() => { f.dn.textContent = next; });
      cur = next;
    }
    tl.call(() => { f.fl.textContent = final; gsap.set(f.flap, { rotateX: 0 }); });
    p._tl = tl;
    return tl;
  }
  // Text "flip": reveals the target left to right through random letters.
  function scramble(el: HTMLElement & { _t?: gsap.core.Tween }, to: string, dur = 0.6, delay = 0) {
    el._t?.kill();
    const from = el.textContent ?? "";
    const o = { p: 0 };
    el._t = gsap.to(o, {
      p: 1, duration: dur, delay, ease: "none",
      onUpdate() {
        const n = Math.floor(o.p * to.length);
        const len = Math.round(from.length + (to.length - from.length) * o.p);
        let s = to.slice(0, n);
        for (let i = n; i < len; i++) s += to[i] === " " ? " " : LOW[(Math.random() * LOW.length) | 0];
        el.textContent = s;
      },
      onComplete() { el.textContent = to; },
    });
  }
  const garble = (s: string) => s.replace(/\S/g, () => LOW[(Math.random() * LOW.length) | 0]);

  // Real clock of the visitor (HH:MM); flips the cells that change.
  function startClock(animated: boolean) {
    const cells = $$("[data-reloj] [data-p]") as Flap[];
    let last = "";
    const tick = () => {
      const d = new Date();
      const h = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
      if (h === last) return;
      [...h].forEach((c, i) => {
        if (last[i] === c) return;
        if (animated) spin(cells[i], c, last ? rint(2, 4) : rint(5, 8), last ? 0 : i * 0.04);
        else setChar(cells[i], c);
      });
      last = h;
    };
    tick();
    setInterval(tick, 1000);
  }

  function main() {
    if (!root.classList.contains("anim")) {
      startClock(false); // reduced motion or JS too late: static, ordered page
      return;
    }

    // 1 · Loader: 8 flaps settle on «EN ORDEN», then the board opens (≈1.15 s)
    const carga = document.querySelector<HTMLElement>("[data-carga]")!;
    let fin = 0;
    ($$("[data-p]", carga) as Flap[]).forEach((p, i) => {
      setChar(p, rnd());
      const n = rint(6, 9), d = 0.04 + i * 0.04;
      spin(p, ch(p), n, d);
      fin = Math.max(fin, d + n * STEP);
    });
    const abre = fin + 0.08;
    gsap.timeline({ delay: abre })
      .to(carga.querySelector(".fila"), { opacity: 0, duration: 0.15, ease: "power3.out" })
      .to("[data-carga-a]", { yPercent: -100, duration: 0.36, ease: "power3.inOut" }, 0.04)
      .to("[data-carga-b]", { yPercent: 100, duration: 0.36, ease: "power3.inOut" }, 0.04)
      .set(carga, { display: "none" });

    // 2 · Hero: two rows flip in, 40 ms stagger left to right
    const heroRows = $$("[data-hero] [data-fila]");
    let heroFin = 0;
    heroRows.forEach((row, r) => {
      ($$("[data-p]", row) as Flap[]).forEach((p, i) => {
        setChar(p, rnd());
        const n = rint(6, 12), d = abre + 0.1 + r * 0.14 + i * 0.04;
        spin(p, ch(p), n, d);
        heroFin = Math.max(heroFin, d + n * STEP);
      });
    });
    gsap.fromTo("[data-hero-sub]", { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", stagger: 0.1, delay: abre + 0.35 });
    startClock(true);

    // Button micro-interaction: the label does a short flap flip on hover/focus
    $$("[data-mini]").forEach((btn) => {
      const letters = $$(".mini", btn);
      let busy = false;
      const go = () => {
        if (busy) return;
        busy = true;
        letters.forEach((s) => { if (!s.style.width) s.style.width = `${s.getBoundingClientRect().width}px`; });
        const tl = gsap.timeline({ onComplete: () => { busy = false; } });
        letters.forEach((s, i) => {
          const c = s.dataset.c ?? "";
          if (!/[A-Za-zÁÉÍÓÚÑáéíóúñ]/.test(c)) return;
          const t = i * 0.022;
          tl.to(s, { rotateX: -90, duration: 0.07, ease: "power1.in" }, t)
            .call(() => { s.textContent = rnd(); }, undefined, t + 0.07)
            .fromTo(s, { rotateX: 90 }, { rotateX: 0, duration: 0.07, ease: "power3.out", immediateRender: false }, t + 0.07)
            .to(s, { rotateX: -90, duration: 0.06, ease: "power1.in" }, t + 0.15)
            .call(() => { s.textContent = c; }, undefined, t + 0.21)
            .fromTo(s, { rotateX: 90 }, { rotateX: 0, duration: 0.12, ease: "power3.out", immediateRender: false }, t + 0.21);
        });
      };
      btn.addEventListener("mouseenter", go);
      btn.addEventListener("focus", go);
    });

    // Headings and blocks rise in
    $$("[data-sube]").forEach((el) =>
      gsap.to(el, { opacity: 1, y: 0, duration: 0.8, ease: "power3.out", scrollTrigger: { trigger: el, start: "top 88%", once: true } }),
    );

    // 3 · ¿Te suena?: blank board, lines flip in when the panel reaches 75 %
    const suena = document.querySelector<HTMLElement>("[data-suena]")!;
    const rl = $$("[data-r]", suena);
    rl.forEach((l) => {
      ($$("[data-p]", l) as Flap[]).forEach((p) => setChar(p, " "));
      const d = l.querySelector<HTMLElement>("[data-scr]")!;
      d.dataset.fin = d.textContent ?? "";
      d.textContent = garble(d.dataset.fin);
    });
    ScrollTrigger.create({
      trigger: suena.querySelector(".retrasos"),
      start: "top 75%",
      once: true,
      onEnter() {
        rl.forEach((l, li) => {
          const base = li * 0.2;
          ($$("[data-p]", l) as Flap[]).forEach((p, i) => spin(p, ch(p), rint(6, 12), base + i * 0.03));
          const d = l.querySelector<HTMLElement>("[data-scr]")!;
          scramble(d, d.dataset.fin ?? "", 0.7, base + 0.15);
        });
      },
    });

    // 4 · Departures board: pinned, each line flips from RETRASADO to its ordered state
    const sal = document.querySelector<HTMLElement>("[data-salidas]")!;
    const lineas = $$("[data-linea]", sal);
    const billetes = $$("[data-billete]", sal);
    const RET = "RETRASADO".padEnd(10, " ");
    const orden = lineas.map(() => false);
    lineas.forEach((l) => {
      l.classList.remove("on");
      l.querySelector<HTMLElement>("[data-q]")!.textContent = l.dataset.antes ?? "";
      ($$("[data-p]", l.querySelector("[data-e]")!) as Flap[]).forEach((p, i) => setChar(p, RET[i]));
    });
    const ordenar = (i: number, on: boolean) => {
      if (orden[i] === on) return;
      orden[i] = on;
      const l = lineas[i];
      l.classList.toggle("on", on);
      const fin = (on ? l.dataset.estado ?? "" : "RETRASADO").padEnd(10, " ");
      ($$("[data-p]", l.querySelector("[data-e]")!) as Flap[]).forEach((p, k) => spin(p, fin[k], rint(6, 10), k * 0.04));
      scramble(l.querySelector<HTMLElement>("[data-q]")!, (on ? l.dataset.despues : l.dataset.antes) ?? "", 0.55);
    };
    let activa = -2;
    const activar = (i: number) => {
      if (i === activa) return;
      activa = i;
      lineas.forEach((l, k) => l.classList.toggle("activa", k === i));
      billetes.forEach((b) => b.classList.remove("vis"));
      const b = billetes[i + 1];
      b.classList.add("vis");
      gsap.fromTo(b, { opacity: 0, y: 18, rotate: i % 2 ? 1.2 : -1.2 }, { opacity: 1, y: 0, rotate: 0, duration: 0.5, ease: "power3.out" });
    };

    const mm = gsap.matchMedia();
    mm.add({ mob: "(max-width: 760px)", desk: "(min-width: 761px)" }, (ctx) => {
      const { mob } = ctx.conditions as { mob: boolean };
      const tramo = mob ? 0.6 : 0.8; // viewport heights per line
      const tl = gsap.timeline().fromTo("[data-barra]", { scaleX: 0 }, { scaleX: 1, ease: "none" });
      ScrollTrigger.create({
        trigger: sal.querySelector("[data-pin]"),
        pin: true,
        start: "top top",
        end: () => `+=${7 * innerHeight * tramo}`,
        scrub: 0.6,
        animation: tl,
        invalidateOnRefresh: true,
        onUpdate(self) {
          const p = self.progress;
          let k = -1;
          for (let i = 0; i < 7; i++) if (p >= (i + 0.3) / 7.3) k = i;
          lineas.forEach((_, i) => ordenar(i, i <= k));
          activar(k);
        },
      });
    });
    activar(-1);

    // 5 · Route line draws with the scroll; each stop lights up as the line reaches it
    const trabajo = document.querySelector<HTMLElement>("[data-trabajo]")!;
    const tramos = $$("[data-tramo]", trabajo);
    gsap.timeline({
      scrollTrigger: {
        trigger: trabajo.querySelector(".billete-largo"),
        start: "top 72%",
        end: "bottom 50%",
        scrub: 0.6,
        onUpdate(self) {
          [0.02, 0.4, 0.78].forEach((u, i) => tramos[i].classList.toggle("on", self.progress >= u));
        },
      },
    }).fromTo($$("[data-ruta]", trabajo), { strokeDashoffset: 1 }, { strokeDashoffset: 0, ease: "none" });

    // 7 · Closing board flips to «¿LO PONEMOS EN ORDEN?»
    const final = document.querySelector<HTMLElement>("[data-final]")!;
    ($$("[data-p]", final) as Flap[]).forEach((p) => setChar(p, " "));
    ScrollTrigger.create({
      trigger: final.querySelector(".final-panel"),
      start: "top 70%",
      once: true,
      onEnter() {
        $$("[data-fila]", final).forEach((row, r) =>
          ($$("[data-p]", row) as Flap[]).forEach((p, i) => spin(p, ch(p), rint(6, 12), r * 0.15 + i * 0.04)),
        );
      },
    });

    root.classList.add("listo");
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }

  main();
</script>

---
// Prototype B · «El panel de salidas»: Solari split-flap board, «del desorden al orden».
import Prueba from "../../layouts/Prueba.astro";
import "./_b.css";

const WA = "https://wa.me/34624664907?text=Hola%2C%20quiero%20la%20revisi%C3%B3n%20gratis%20de%20mi%20negocio";
const fuentes =
  "https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap";

// One flap: static top half (next char), static bottom half (current), falling flap (current top half).
const esc = (c: string) => (c === "&" ? "&amp;" : c === "<" ? "&lt;" : c === '"' ? "&quot;" : c);
const flap = (c: string) => {
  const e = esc(c);
  return `<span class="p" data-p data-ch="${e}" aria-hidden="true"><span class="p-h p-up"><span class="p-c">${e}</span></span><span class="p-h p-dn"><span class="p-c">${e}</span></span><span class="p-h p-up p-fl"><span class="p-c">${e}</span></span></span>`;
};
// Words wrap as whole groups, so rows break cleanly on phones.
const fila = (t: string) =>
  t.split(" ").map((w) => `<span class="pw">${[...w].map(flap).join("")}</span>`).join("");
// Fixed number of cells (status columns): spaces become blank flaps.
const celdas = (t: string, n: number) => [...t.padEnd(n, " ")].map(flap).join("");
// Button label split into flippable letters.
const mini = (t: string) =>
  [...t].map((c) => (c === " " ? " " : `<span class="mini" data-c="${esc(c)}" aria-hidden="true">${esc(c)}</span>`)).join("");

const retrasos = [
  ["FACTURAS", "las hago de noche"],
  ["CLIENTES", "dejan de venir y no me entero"],
  ["WHATSAPP", "contesto hasta en la cena"],
  ["TRIMESTRE", "siempre me pilla"],
  ["INSTAGRAM", "abandonado"],
];

const lineas = [
  { h: "07:12", p: "Clientes que se van", antes: "No sé quién ha dejado de venir", q: "Lucía lleva 40 días sin venir", e: "AVISADO", tono: "amar", x: "Te avisamos cuando un cliente deja de venir, antes de perderlo." },
  { h: "07:20", p: "Recuperar clientes", antes: "Nadie les ha escrito", q: "Mensaje enviado a 6 clientes", e: "EN CAMINO", tono: "amar", x: "Le llega el mensaje en el momento justo, y vuelve." },
  { h: "07:31", p: "Seguimiento", antes: "Mensajes sin contestar desde el lunes", q: "Nadie sin contestar", e: "EN HORA", tono: "verde", x: "Cada cliente con su siguiente paso." },
  { h: "07:40", p: "Facturas y trimestre", antes: "Facturas en una caja, trimestre sin empezar", q: "128 facturas, trimestre listo", e: "HECHO", tono: "verde", x: "Las facturas salen solas y el trimestre llega preparado para la gestoría." },
  { h: "07:46", p: "Redes sociales", antes: "Última publicación hace dos meses", q: "5 publicaciones programadas", e: "PROGRAMADO", tono: "verde", x: "Preparadas y programadas sin estar encima." },
  { h: "07:52", p: "WhatsApp", antes: "23 mensajes sin leer", q: "14 mensajes contestados de noche", e: "EN HORA", tono: "verde", x: "Contesta al momento, a cualquier hora, y te pasa lo importante." },
  { h: "07:58", p: "Cómo están tus clientes", antes: "Ni idea de quién debe", q: "3 se enfrían, 1 debe", e: "AVISADO", tono: "amar", x: "Un panel: quién está bien, quién se enfría, quién debe." },
];

const tramos = [
  { n: "Tramo 1", t: "Revisión del negocio", x: "30 minutos y tres arreglos por escrito en 48 horas.", pie: "Gratis" },
  { n: "Tramo 2", t: "Puesta en orden", x: "Precio y plazo cerrados antes de empezar. Pagas por hitos, según lo ves funcionando.", pie: "Precio cerrado" },
  { n: "Tramo 3", t: "A tu lado", x: "Cuota mensual sin permanencia: lo vigilamos, lo arreglamos y lo mejoramos.", pie: "Sin permanencia" },
];
---

<Prueba titulo="Padrón IA · Tu negocio, en orden (prototipo B)" letra="b" fuentes={fuentes}>
  <script is:inline>
    // Animation states only when JS runs and motion is welcome; dropped if the module never arrives.
    (function () {
      var d = document.documentElement;
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      d.classList.add("anim");
      setTimeout(function () { if (!d.classList.contains("listo")) d.classList.remove("anim"); }, 4000);
    })();
  </script>

  <!-- 1 · Loader -->

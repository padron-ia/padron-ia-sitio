  .pie a { color: #c9cce8; }
  .pie a:hover { color: var(--lav); }

  /* ---------- Animated initial states (only with .anim → no flash, no hidden content without JS) ---------- */
  .anim [data-anim="linea"] { transform: translateY(105%); }
  .anim [data-anim="entra"],
  .anim [data-anim="aparece"] { opacity: 0; transform: translateY(24px); }
  .anim [data-anim="nota"] { clip-path: inset(0% 100% 0% 0%); }
  .anim [data-anim="tachon"] { transform: scaleX(0); }
  .anim .sello[data-anim] { opacity: 0; }
  .anim [data-anim="suena"] { opacity: 0; transform: translateY(30px); }
  .anim [data-anim="paso"] { opacity: 0; transform: translateY(24px); }
  .anim .arrugas { opacity: 1; }
  .anim .est-pend { opacity: 1; }
  .anim .est-ok { opacity: 0; }
  .anim .proc-antes { opacity: 1; }
  .anim [data-anim="despues"] { opacity: 0; clip-path: inset(0% 100% 0% 0%); }

  /* Desktop with motion: the pad is stacked and pinned */
  @media (min-width: 900px) {
    .anim .escenario {
      height: 100vh;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 18px;
      padding: 28px 0 76px; /* bottom room keeps the line clear of the A/B/C switcher */
    }
    .anim .pila { gap: 0; align-items: center; }
    .anim .proc { grid-area: 1 / 1; }
    .anim .proc-hoja { transform: rotate(var(--rot)); }
    .anim .proc-copia { inset: 0; transform: rotate(-1.6deg); }
    .anim .proc-cuerpo { grid-template-areas: "x"; }
    .anim .proc-antes,
    .anim .proc-despues { grid-area: x; align-self: start; }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 899px) {
    .talonario { grid-template-columns: minmax(0, 1fr); }
    .matriz {
      height: auto;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 6px 12px;
      padding: 10px 16px 12px;
      box-shadow: 0 6px 18px #0004;
    }
    .matriz::after {
      top: auto;
      left: 0;
      right: 0;
      bottom: -6px;
      width: auto;
      height: 12px;
      background: radial-gradient(circle, var(--tinta) 3px, transparent 3.5px) 0 0 / 18px 12px;
    }
    .marca { font-size: 20px; }
    .reloj { margin: 0; grid-row: 1; grid-column: 2; grid-auto-flow: column; align-items: baseline; gap: 8px; }
    .reloj-l { font-size: 14px; letter-spacing: 0.1em; }
    .reloj b { font-size: 22px; }
    .tel { display: none; }
    .indice { grid-column: 1 / -1; }
    .indice ol { display: flex; justify-content: space-between; gap: 2px; }
    .indice a { display: block; padding: 6px 2px 8px; }
    .indice .mt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .indice a.on::after { left: 0; width: 100%; }
    .indice a.hecho .mn::after { display: none; }
    .indice a.hecho .mn { color: var(--calco); }
    [id] { scroll-margin-top: 104px; }

    .mesa { padding: 24px 16px 0; gap: 56px; }
    .pliego::before { inset: 10px -6px -8px 8px; }
    .hoja { padding: 22px 18px 32px; }
    .tipo { font-size: 14px; letter-spacing: 0.18em; }
    .num { font-size: 24px; }
    .num small { font-size: 14px; }
    .casillas.c4, .casillas.c3 { grid-template-columns: repeat(2, 1fr); }
    .casillas > div { border-bottom: 1px solid var(--linea); }
    .casillas.c4 > div:nth-child(2n), .casillas.c3 > div:nth-child(2n) { border-right: 0; }
    .casillas dt, .lio-l, .lbl, .casilla-suelta span { font-size: 14px; letter-spacing: 0.1em; }
    .casillas dd { font-size: 16px; }
    .hoja-hero { min-height: 0; }
    .hero-pie { grid-template-columns: minmax(0, 1fr); gap: 36px; padding-top: 24px; }
    .btn { display: block; width: 100%; text-align: center; font-size: 18px; padding: 18px 16px; }
    .cta-nota { font-size: 15px; }
    .lio { min-height: 0; padding-right: 0; padding-bottom: 136px; }
    .sello small { font-size: 14px; }
    .nota-t { font-size: 26px; }
    .sello-hero { width: 124px; height: 124px; font-size: 20px; right: 4px; bottom: 0; }

    .hoja-suena { background: repeating-linear-gradient(var(--papel) 0 47px, #c9cce099 47px 48px), var(--papel); }
    .suena { grid-template-columns: minmax(0, 1fr); gap: 24px; margin-top: 24px; }
    .margen li span { font-size: 27px; }

    .proc-hoja, .proc-copia { padding: 22px 18px 26px; }
    .proc-copia { inset: 8px -6px -8px 8px; }
    .proc-t { max-width: none; font-size: clamp(40px, 12vw, 56px); }
    .proc-cuerpo { padding-right: 0; padding-bottom: 104px; }
    .garabato { font-size: 27px; }
    .sueltas span { font-size: 22px; }
    .impreso { font-size: 19px; }
    .sello-proc { width: 112px; height: 112px; font-size: 19px; right: 16px; bottom: 16px; }
    .escala { font-size: 16px; padding: 0 8px; }

    .pasos { grid-template-columns: minmax(0, 1fr); }
    .paso { border-right: 0; border-bottom: 1px solid var(--linea); min-height: 0; padding: 20px 18px 24px; padding-right: 124px; }
    .paso:last-child { border-bottom: 0; }
    .paso-d { font-size: 16px; }
    .sello-mini { width: 100px; height: 100px; font-size: 14px; right: 12px; top: 18px; bottom: auto; }

    .hoja-quien { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .foto { max-width: 280px; }

    .sello-cierre { position: relative; right: auto; top: auto; margin: 36px 0 0 auto; width: 120px; height: 120px; font-size: 20px; }
    .pie { flex-direction: column; padding-bottom: 120px; }
  }

  /* Reduced motion: no loader, no pin, everything placed and still */
  @media (prefers-reduced-motion: reduce) {
    .carga { display: none !important; }
    .btn { transition: none; }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const root = document.documentElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const EASE = "power3.out"; // house ease for entrances
  const q = (s: string, el: ParentNode = document) => el.querySelector<HTMLElement>(s);
  const qa = (s: string, el: ParentNode = document) => Array.from(el.querySelectorAll<HTMLElement>(s));

  // ---- Clock and stub state (shared by every mode) ----
  const reloj = q('[data-anim="reloj"]');
  const enlaces = qa('[data-anim="indice"]');
  const INICIO = 23 * 60 + 47; // 23:47
  const TRAMO = 24 * 60 - INICIO + 8 * 60; // → 08:00 next morning
  const dos = (n: number) => String(n).padStart(2, "0");
  let ultimo = -2;

  function marcar(progreso: number) {
    const p = Math.min(1, Math.max(0, progreso));
    const m = Math.round(INICIO + TRAMO * p) % (24 * 60);
    if (reloj) reloj.textContent = `${dos(Math.floor(m / 60))}:${dos(m % 60)}`;
    // index of the sheet on top: switches once the previous one has been torn off
    const activo = p <= 0 ? -1 : p >= 1 ? 7 : Math.min(6, Math.floor(p * 7 + 0.08));
    if (activo === ultimo) return;
    ultimo = activo;
    enlaces.forEach((a, i) => {
      const on = i === activo;
      a.classList.toggle("on", on);
      a.classList.toggle("hecho", i < activo);
      if (on) a.setAttribute("aria-current", "step");
      else a.removeAttribute("aria-current");
    });
  }

  if (!reduce && root.classList.contains("anim")) {
    // ---- 1 · Loader is pure CSS; this line removes it once the curtain is up ----
    gsap.delayedCall(1.2, () => q('[data-anim="carga"]')?.remove());

    // ---- 2 · Hero ----
    const sello = q('[data-anim="sello-hero"]');
    const hero = gsap.timeline({ delay: 0.95, defaults: { ease: EASE } });
    hero
      .to('[data-anim="linea"]', { y: 0, yPercent: 0, duration: 0.9, stagger: 0.08 })
      .to('[data-anim="entra"]', { opacity: 1, y: 0, duration: 0.7, stagger: 0.1 }, "-=0.55")
      .fromTo(
        '[data-anim="nota"]',
        { clipPath: "inset(0% 100% 0% 0%)" },
        { clipPath: "inset(0% 0% 0% 0%)", duration: 0.5, stagger: 0.25, ease: "power2.out" },
        "-=0.3",
      )
      .to('[data-anim="tachon"]', { scaleX: 1, duration: 0.35, stagger: 0.08, ease: "power3.inOut" }, "+=0.15")
      .fromTo(
        sello,
        { scale: 1.6, rotation: -24, opacity: 0 },
        { scale: 1, rotation: -12, opacity: 1, duration: 0.45, ease: "back.out(2.2)" },
        "+=0.05",
      );

    // micro-interaction: the stamp «thumps» when the button is hovered
    q('[data-anim="btn-hero"]')?.addEventListener("mouseenter", () => {
      if (!sello || hero.isActive()) return;
      gsap.fromTo(sello, { scale: 0.92 }, { scale: 1, duration: 0.2, ease: EASE, overwrite: "auto" });
    });

    // ---- 3 · ¿Te suena? ----
    gsap.to('[data-anim="suena"]', {
      y: 0,
      opacity: 1,
      duration: 0.7,
      stagger: 0.12,
      ease: EASE,
      scrollTrigger: { trigger: '[data-anim="sec-suena"]', start: "top 75%" },
    });

    // ---- 4 · The 7 sheets ----
    const seccion = q('[data-anim="sec-hojas"]')!;
    const escenario = q('[data-anim="escenario"]')!;
    const procs = qa('[data-anim="proc"]');
    let pinST: ScrollTrigger | null = null;
    const mm = gsap.matchMedia();

    // Desktop: pinned pad, one sheet per 90vh of scroll
    mm.add("(min-width: 900px)", () => {
      const tl = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: escenario,
          pin: true,
          scrub: 0.6,
          start: "top top",
          end: () => "+=" + window.innerHeight * 0.9 * procs.length,
          invalidateOnRefresh: true,
          onUpdate: (st) => marcar(st.progress),
          onLeave: () => marcar(1),
          onLeaveBack: () => marcar(0),
        },
      });
      pinST = tl.scrollTrigger ?? null;

      procs.forEach((p, i) => {
        const hoja = q('[data-anim="hoja"]', p);
        const t = i; // one timeline unit per sheet
        tl.to(q('[data-anim="arrugas"]', p), { opacity: 0, duration: 0.25 }, t + 0.05)
          .to(hoja, { rotation: 0, duration: 0.25, ease: EASE }, t + 0.05)
          .to(q('[data-anim="antes"]', p), { opacity: 0, y: -12, duration: 0.18 }, t + 0.1)
          .fromTo(
            q('[data-anim="despues"]', p),
            { opacity: 0, clipPath: "inset(0% 100% 0% 0%)" },
            { opacity: 1, clipPath: "inset(0% 0% 0% 0%)", duration: 0.22, ease: EASE },
            t + 0.24,
          )
          .to(q('[data-anim="est-pend"]', p), { opacity: 0, duration: 0.06 }, t + 0.46)
          .to(q('[data-anim="est-ok"]', p), { opacity: 1, duration: 0.06 }, t + 0.48)
          .fromTo(
            q('[data-anim="sello-proc"]', p),
            { scale: 1.6, rotation: -24, opacity: 0 },
            { scale: 1, rotation: -12, opacity: 1, duration: 0.12, ease: "back.out(2.2)" },
            t + 0.46,
          );
        if (i < procs.length - 1) {
          // tear the sheet off; its carbon copy shows for a moment, then gives way to the next sheet
          tl.to(hoja, { yPercent: -120, rotation: -4, duration: 0.2, ease: "power2.in" }, t + 0.72)
            .to(hoja, { autoAlpha: 0, duration: 0.04 }, t + 0.9) // gone from the desk once torn off
            .to(q('[data-anim="copia"]', p), { opacity: 0, duration: 0.07 }, t + 0.93);
        } else {
          tl.to({}, { duration: 0.3 }, t + 0.7); // the last sheet stays, sealed
        }
      });

      return () => {
        pinST = null;
      };
    });

    // Mobile: sheets stacked in flow, each one is put in order and stamped as it enters
    mm.add("(max-width: 899px)", () => {
      procs.forEach((p) => {
        gsap
          .timeline({ defaults: { ease: EASE }, scrollTrigger: { trigger: p, start: "top 70%" } })
          .to(q('[data-anim="arrugas"]', p), { opacity: 0, duration: 0.4 })
          .to(q('[data-anim="antes"]', p), { opacity: 0.8, duration: 0.3 }, "<")
          .fromTo(
            q('[data-anim="despues"]', p),
            { opacity: 0, clipPath: "inset(0% 100% 0% 0%)" },
            { opacity: 1, clipPath: "inset(0% 0% 0% 0%)", duration: 0.5 },
            "-=0.1",
          )
          .to(q('[data-anim="est-pend"]', p), { opacity: 0, duration: 0.15 })
          .to(q('[data-anim="est-ok"]', p), { opacity: 1, duration: 0.15 }, "<")
          .fromTo(
            q('[data-anim="sello-proc"]', p),
            { scale: 1.6, rotation: -24, opacity: 0 },
            { scale: 1, rotation: -12, opacity: 1, duration: 0.45, ease: "back.out(2.2)" },
            "<",
          );
      });
      ScrollTrigger.create({
        trigger: seccion,
        start: "top center",
        end: "bottom center",
        onUpdate: (st) => marcar(st.progress),
        onLeave: () => marcar(1),
        onLeaveBack: () => marcar(0),
      });
    });

    // Stub links: inside the pinned pad, jump to the scroll point where that sheet is stamped
    enlaces.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        if (!pinST) return;
        e.preventDefault();
        const y = pinST.start + ((i + 0.62) / procs.length) * (pinST.end - pinST.start);
        window.scrollTo(0, y);
      }),
    );

    // ---- 5 · How we work: each box lands, then its stamp ----
    const pasos = gsap.timeline({
      defaults: { ease: EASE },
      scrollTrigger: { trigger: '[data-anim="sec-como"]', start: "top 75%" },
    });
    qa('[data-anim="paso"]').forEach((paso, i) => {
      pasos
        .to(paso, { opacity: 1, y: 0, duration: 0.6 }, i * 0.22)
        .fromTo(
          q('[data-anim="sello-paso"]', paso),
          { scale: 1.6, rotation: -24, opacity: 0 },
          { scale: 1, rotation: -12, opacity: 1, duration: 0.45, ease: "back.out(2.2)" },
          i * 0.22 + 0.35,
        );
    });

    // ---- 6 · Who ----
    gsap.to('[data-anim="sec-quien"] [data-anim="aparece"]', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: EASE,
      scrollTrigger: { trigger: '[data-anim="sec-quien"]', start: "top 75%" },
    });

    // ---- 7 · Close ----
    gsap
      .timeline({ defaults: { ease: EASE }, scrollTrigger: { trigger: '[data-anim="sec-cierre"]', start: "top 70%" } })
      .to('[data-anim="sec-cierre"] [data-anim="aparece"]', { opacity: 1, y: 0, duration: 0.8, stagger: 0.15 })
      .fromTo(
        '[data-anim="sello-cierre"]',
        { scale: 1.6, rotation: -24, opacity: 0 },
        { scale: 1, rotation: -12, opacity: 1, duration: 0.45, ease: "back.out(2.2)" },
        "-=0.2",
      );

    document.fonts?.ready.then(() => ScrollTrigger.refresh());
  }
</script>

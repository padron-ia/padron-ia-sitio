---
// Prototype A · «El talonario con papel de calco».
// Every process is a numbered sheet: it comes in scribbled, leaves printed and stamped.
// Content lives in the HTML; GSAP only places it. Reduced motion or no JS = static, fully readable page.
import Prueba from "../../layouts/Prueba.astro";

const fuentes =
  "https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Caveat:wght@500;700&family=Courier+Prime:wght@400;700&display=swap";
const WA =
  "https://wa.me/34624664907?text=Hola%2C%20quiero%20la%20revisi%C3%B3n%20gratis%20de%20mi%20negocio";

const hojas = [
  { n: "0001", t: "Clientes que se van", antes: "¿Marta? hace mil que no viene", sueltas: ["¿3 meses?", "Luis también??"], despues: "Te avisamos cuando un cliente deja de venir, antes de perderlo." },
  { n: "0002", t: "Recuperar clientes", antes: "habría que escribirles… algún día", sueltas: ["¿descuento?", "lista → ???"], despues: "Le llega el mensaje justo en el momento justo, y vuelve." },
  { n: "0003", t: "Seguimiento", antes: "¿a quién le debía una respuesta?", sueltas: ["llamar jueves", "¿le contesté?"], despues: "Cada cliente con su siguiente paso. Nadie se queda sin contestar." },
  { n: "0004", t: "Facturas y trimestre", antes: "caja de tickets para la gestoría", sueltas: ["147,30 + IVA", "¡¡día 20!!"], despues: "Las facturas salen solas y el trimestre llega preparado." },
  { n: "0005", t: "Redes sociales", antes: "subir algo esta semana (otra vez)", sueltas: ["último: julio", "¿fotos?"], despues: "Publicaciones preparadas y programadas sin estar encima." },
  { n: "0006", t: "WhatsApp", antes: "14 sin leer, 3 de ayer", sueltas: ["+ 4 audios", "23:58"], despues: "Contesta al momento, a cualquier hora, y te pasa lo importante." },
  { n: "0007", t: "Cómo están tus clientes", antes: "lo tengo en la cabeza", sueltas: ["¿Ana debía algo?", "¿quién más?"], despues: "Un panel: quién está bien, quién se enfría, quién debe." },
];
// Slight tilt per sheet while it is still «crumpled».
const giros = ["1.6deg", "-1.2deg", "1.1deg", "-1.7deg", "1.3deg", "-0.9deg", "1.5deg"];

const notasHero = [
  { t: "llamar a Marta (¿se fue?)", r: "-4deg", x: "0px" },
  { t: "facturas del trimestre!!", r: "3deg", x: "64px" },
  { t: "contestar 14 whatsapps", r: "-2deg", x: "8px" },
  { t: "subir algo a Instagram", r: "4deg", x: "40px" },
];

const suena = [
  { t: "Las facturas las hago cuando puedo, casi siempre de noche.", r: "-1.5deg" },
  { t: "Hay clientes que dejan de venir y ni me entero.", r: "1deg" },
  { t: "Contesto WhatsApps hasta en la cena.", r: "-0.8deg" },
  { t: "El trimestre siempre me pilla.", r: "1.6deg" },
  { t: "Instagram lo tengo abandonado.", r: "-1.2deg" },
];

const pasos = [
  { n: "1", t: "Revisión del negocio", d: "30 minutos y tres arreglos por escrito en 48 horas. Gratis.", s: "Gratis" },
  { n: "2", t: "Puesta en orden", d: "Precio y plazo cerrados. Pagas por hitos.", s: "Cerrado" },
  { n: "3", t: "A tu lado", d: "Cuota mensual sin permanencia: lo vigilamos, lo arreglamos y lo mejoramos.", s: "Sin permanencia" },
];

// Loader papers: scattered offsets and tilts before they square up into a pad.
const papeles = [
  { x: "-38vw", y: "-22vh", r: "-28deg" },
  { x: "30vw", y: "-30vh", r: "22deg" },
  { x: "-26vw", y: "28vh", r: "14deg" },
  { x: "36vw", y: "20vh", r: "-18deg" },
  { x: "-8vw", y: "-38vh", r: "9deg" },
  { x: "14vw", y: "36vh", r: "-12deg" },
  { x: "0vw", y: "0vh", r: "-6deg" },
];
---

<Prueba titulo="Prototipo A · Talonario · Padrón IA" letra="a" fuentes={fuentes}>
  <script is:inline>
    // Animation-ready flag: hidden initial states only apply when motion is allowed and JS runs.
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("anim");
  </script>

  <div class="carga" data-anim="carga" aria-hidden="true">
    {papeles.map((p, i) => (
      <i style={`--i:${i};--x:${p.x};--y:${p.y};--r:${p.r}`}>{i === 6 && <b>Nº 0001</b>}</i>
    ))}
  </div>

  <div class="talonario">
    <!-- Stub of the pad = navigation, clock and phone -->
    <aside class="matriz">
      <a class="marca" href="#arriba">PADRÓN <b>IA</b></a>
      <nav class="indice" aria-label="Las 7 hojas">
        <ol>
          {hojas.map((h, i) => (
            <li>
              <a href={`#hoja-${h.n}`} data-anim="indice" data-i={i}>
                <span class="mn">{h.n}</span><span class="mt">{h.t}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <p class="reloj"><span class="reloj-l">Hora</span><b data-anim="reloj">23:47</b></p>
      <a class="tel" href={WA}>+34 624 66 49 07</a>
    </aside>

    <main class="mesa">
      <!-- 2 · First screen: sheet Nº 0001 -->
      <section class="pliego" id="arriba" aria-labelledby="titular">
        <div class="hoja hoja-hero">
          <header class="cab">
            <p class="tipo">Hoja de orden · Tu negocio</p>
            <p class="num"><small>Nº</small>0001</p>
          </header>
          <dl class="casillas c4">
            <div><dt>Para</dt><dd>el dueño</dd></div>
            <div><dt>Sector</dt><dd>el tuyo</dd></div>
            <div><dt>Permanencia</dt><dd>ninguna</dd></div>
            <div><dt>Tus datos</dt><dd>siempre tuyos</dd></div>
          </dl>

          <h1 id="titular" class="titular">
            <span class="l"><span data-anim="linea">Tu negocio,</span></span>
            <span class="l"><span data-anim="linea"><em>en orden.</em></span></span>
          </h1>

          <div class="hero-pie">
            <div class="hero-texto">
              <p class="sub" data-anim="entra">
                Clientes que no se pierden, seguimiento al día, facturas y trimestre listos, un WhatsApp que contesta.
                Lo ponemos en marcha y nos quedamos para que siga funcionando.
              </p>
              <div class="cta" data-anim="entra">
                <a class="btn" href={WA} data-anim="btn-hero">Pide tu revisión gratis por WhatsApp</a>
                <p class="cta-nota">30 min · 3 arreglos por escrito en 48 h</p>
              </div>
            </div>

            <div class="lio">
              <p class="lio-l">Lo de esta noche</p>
              <ul class="notas">
                {notasHero.map((n) => (
                  <li class="nota" style={`--r:${n.r};--x:${n.x}`}>
                    <span class="nota-t" data-anim="nota">
                      {n.t}<i class="tachon" data-anim="tachon" aria-hidden="true"></i>
                    </span>
                  </li>
                ))}
              </ul>
              <div class="sello sello-hero" data-anim="sello-hero" aria-label="Sello: en orden">
                <span>EN ORDEN<small>LO HACEMOS</small></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3 · ¿Te suena? -->
      <section class="pliego" id="te-suena" aria-labelledby="t-suena" data-anim="sec-suena">
        <div class="hoja hoja-suena">
          <header class="cab">
            <p class="tipo">Notas al margen</p>
            <p class="num"><small>Nº</small>0002</p>
          </header>
          <div class="suena">
            <h2 id="t-suena" class="h2-gordo">¿Te<br />suena?</h2>
            <ul class="margen">
              {suena.map((s) => (
                <li data-anim="suena"><span style={`--r:${s.r}`}>«{s.t}»</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- 4 · The 7 sheets (signature piece) -->
      <section class="sec-hojas" id="hojas" aria-labelledby="t-hojas" data-anim="sec-hojas">
        <div class="escenario" data-anim="escenario">
          <h2 id="t-hojas" class="escenario-l">Lo que ponemos en orden · 7 hojas</h2>
          <div class="pila">
            {hojas.map((h, i) => (
              <article class="proc" id={`hoja-${h.n}`} data-anim="proc" style={`--z:${7 - i};--rot:${giros[i]}`} aria-labelledby={`t-${h.n}`}>
                <div class="proc-copia" data-anim="copia" aria-hidden="true">
                  <p class="cp-n">COPIA · Nº {h.n}</p>
                  <p class="cp-t">{h.t}</p>
                  <p class="cp-d">{h.despues}</p>
                </div>
                <div class="proc-hoja" data-anim="hoja">
                  <span class="arrugas" data-anim="arrugas" aria-hidden="true"></span>
                  <header class="cab">
                    <p class="tipo">Hoja de orden</p>
                    <p class="num"><small>Nº</small>{h.n}</p>
                  </header>
                  <dl class="casillas c2">
                    <div>
                      <dt>Estado</dt>
                      <dd class="estado">
                        <span class="est-pend" data-anim="est-pend">pendiente</span>
                        <span class="est-ok" data-anim="est-ok">en orden</span>
                      </dd>
                    </div>
                    <div><dt>Lo lleva</dt><dd>nosotros, contigo</dd></div>
                  </dl>
                  <h3 id={`t-${h.n}`} class="proc-t">{h.t}</h3>
                  <div class="proc-cuerpo">
                    <div class="proc-antes" data-anim="antes">
                      <p class="lbl">Así estaba</p>
                      <p class="garabato">{h.antes}<i class="tachon" aria-hidden="true"></i></p>
                      <p class="sueltas" aria-hidden="true">
                        <span>{h.sueltas[0]}</span><span>{h.sueltas[1]}</span>
                      </p>
                    </div>
                    <div class="proc-despues" data-anim="despues">
                      <p class="lbl">Así queda</p>
                      <p class="impreso">{h.despues}</p>
                    </div>
                  </div>
                  <div class="sello sello-proc" data-anim="sello-proc" aria-hidden="true">
                    <span>EN ORDEN<small>Nº {h.n}</small></span>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <p class="escala">Funciona igual con 10 clientes que con 1.000.</p>
        </div>
      </section>

      <!-- 5 · How we work -->
      <section class="pliego" id="como" aria-labelledby="t-como" data-anim="sec-como">
        <div class="hoja">
          <header class="cab">
            <p class="tipo">Cómo trabajamos</p>
            <p class="num"><small>Nº</small>0008</p>
          </header>
          <h2 id="t-como" class="h2-gordo h2-medio">Tres pasos,<br />por escrito.</h2>
          <ol class="pasos">
            {pasos.map((p) => (
              <li class="paso" data-anim="paso">
                <span class="paso-n">{p.n}</span>
                <h3 class="paso-t">{p.t}</h3>
                <p class="paso-d">{p.d}</p>
                <span class="sello sello-mini" data-anim="sello-paso" aria-hidden="true"><span>{p.s}</span></span>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- 6 · Who -->
      <section class="pliego" id="quien" aria-labelledby="t-quien" data-anim="sec-quien">
        <div class="hoja hoja-quien">
          <div class="foto" data-anim="aparece">
            <span class="grapa" aria-hidden="true"></span>
            <span class="foto-t">Foto de Jesús</span>
          </div>
          <div class="quien-texto" data-anim="aparece">
            <p class="tipo">Quién lo lleva</p>
            <h2 id="t-quien" class="quien-h">Jesús Martínez Padrón lleva tu negocio contigo.</h2>
            <p class="quien-p">Con nombre, con WhatsApp y sin desaparecer.</p>
            <p class="casilla-suelta"><span>Tus datos</span>siempre tuyos.</p>
          </div>
        </div>
      </section>

      <!-- 7 · Close -->
      <section class="pliego pliego-final" id="cierre" aria-labelledby="t-cierre" data-anim="sec-cierre">
        <div class="hoja hoja-cierre">
          <header class="cab">
            <p class="tipo">Hoja de orden · La tuya</p>
            <p class="num"><small>Nº</small>0009</p>
          </header>
          <dl class="casillas c3">
            <div><dt>Hora</dt><dd>08:00</dd></div>
            <div><dt>Primer paso</dt><dd>revisión gratis</dd></div>
            <div><dt>Permanencia</dt><dd>ninguna</dd></div>
          </dl>
          <h2 id="t-cierre" class="h2-gordo h2-cierre" data-anim="aparece">¿Lo ponemos<br /><em>en orden?</em></h2>
          <div class="cta cta-cierre" data-anim="aparece">
            <a class="btn" href={WA}>Pide tu revisión gratis por WhatsApp</a>
            <p class="cta-nota">o escríbenos a <a href="mailto:hola@padron-ia.es">hola@padron-ia.es</a></p>
          </div>
          <div class="sello sello-cierre" data-anim="sello-cierre" aria-hidden="true">
            <span>EN ORDEN<small>08:00</small></span>
          </div>
        </div>
      </section>
      <footer class="pie">
        <p>© 2026 Padrón IA</p>
        <nav aria-label="Legal">
          <a href="/legal">Aviso legal</a>
          <a href="/privacidad">Privacidad</a>
          <a href="/cookies">Cookies</a>
        </nav>
      </footer>
    </main>
  </div>
</Prueba>

<style is:global>
  :root {
    --papel: #f2f3fb;
    --tinta: #1b1e3a;
    --calco: #3a43b8;
    --rojo: #c8352b;
    --lav: #8f9bff;
    --gris: #50557f; /* labels on paper: ~6.6:1 */
    --linea: #c9cce0;
    --matriz: #e4e6f4;
    --boli: #262b66; /* handwriting ink */
    --casa: cubic-bezier(0.22, 1, 0.36, 1);
  }
  *,
  *::before,
  *::after { box-sizing: border-box; }
  html { background: var(--tinta); }
  body {
    margin: 0;
    background: var(--tinta);
    color: var(--tinta);
    font-family: Archivo, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, p, ul, ol, dl, dd { margin: 0; padding: 0; }
  ul, ol { list-style: none; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--lav); outline-offset: 3px; }
  [id] { scroll-margin-top: 24px; }

  /* ---------- 1 · Loader: papers square up into a pad, then the curtain rises ---------- */
  .carga { display: none; }
  .anim .carga {
    display: grid;
    place-items: center;
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: var(--tinta);
    animation: cortina 0.4s cubic-bezier(0.7, 0, 0.84, 0) 0.8s forwards;
  }
  .carga i {
    position: absolute;
    width: min(40vw, 240px);
    aspect-ratio: 3 / 4;
    background: var(--papel) repeating-linear-gradient(transparent 0 22px, #c9cce066 22px 23px);
    border-left: 10px dotted #b9bdd8;
    border-radius: 2px;
    box-shadow: 0 12px 28px #0006;
    transform: translate(var(--x), var(--y)) rotate(var(--r));
    animation: apilar 0.55s var(--casa) forwards;
    animation-delay: calc(var(--i) * 40ms);
  }
  .carga i b {
    position: absolute;
    top: 14px;
    right: 14px;
    font: 700 16px/1 "Courier Prime", monospace;
    color: var(--rojo);
  }
  @keyframes apilar { to { transform: translate(0, calc(var(--i) * -3px)) rotate(0deg); } }
  @keyframes cortina { to { transform: translateY(-100%); visibility: hidden; } }

  /* ---------- Layout: stub on the left, sheets on the desk ---------- */
  .talonario {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    overflow-x: clip;
    min-height: 100vh;
  }
  .matriz {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding: 30px 26px 30px 22px;
    background: var(--matriz);
    z-index: 20;
  }
  /* perforation */
  .matriz::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    right: -6px;
    width: 12px;
    background: radial-gradient(circle, var(--tinta) 3px, transparent 3.5px) 0 0 / 12px 18px;
  }
  .marca {
    font: 800 24px/1 Archivo, sans-serif;
    font-stretch: 78%;
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .marca b { color: var(--calco); }
  .indice ol { display: grid; gap: 4px; }
  .indice a {
    display: grid;
    grid-template-columns: 52px 1fr;
    align-items: baseline;
    padding: 7px 0;
    text-decoration: none;
    font: 600 15px/1.2 Archivo, sans-serif;
    font-stretch: 75%;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    position: relative;
  }
  .indice .mn { font: 700 14px/1 "Courier Prime", monospace; color: var(--rojo); letter-spacing: 0; }
  .indice a:hover .mt { text-decoration: underline; text-underline-offset: 3px; }
  .indice a.on { color: var(--calco); }
  .indice a.on::after {
    content: "";
    position: absolute;
    left: 52px;
    bottom: 0;
    height: 3px;
    width: 64%;
    background: var(--lav);
  }
  .indice a.hecho .mn { color: var(--tinta); }
  .indice a.hecho .mn::after {
    content: "";
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-left: 4px;
    border: 2px solid var(--rojo);
    border-radius: 50%;
    vertical-align: 1px;
  }
  .reloj { margin-top: auto; display: grid; gap: 4px; }
  .reloj-l { font: 600 12px/1 Archivo, sans-serif; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gris); }
  .reloj b { font: 700 34px/1 "Courier Prime", monospace; letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
  .tel { font: 700 14px/1 "Courier Prime", monospace; color: var(--gris); text-decoration: none; }
  .tel:hover { color: var(--calco); text-decoration: underline; }

  .mesa { padding: 32px 44px 0 40px; display: grid; gap: 72px; min-width: 0; }

  /* A sheet with its carbon copy peeking underneath */
  .pliego { position: relative; }
  .pliego::before {
    content: "";
    position: absolute;
    inset: 16px -12px -14px 14px;
    background: var(--calco);
    border-radius: 3px;
    transform: rotate(-1deg);
  }
  .hoja {
    position: relative;
    z-index: 1;
    background: var(--papel);
    padding: 36px 56px 48px 52px;
    box-shadow: 0 24px 50px #0005;
  }

  /* Printed parts */
  .cab {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    border-bottom: 3px solid var(--tinta);
    padding-bottom: 12px;
  }
  .tipo {
    font: 800 15px/1.2 Archivo, sans-serif;
    font-stretch: 70%;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .num { font: 700 30px/1 "Courier Prime", monospace; color: var(--rojo); letter-spacing: 0.06em; text-align: right; }
  .num small { display: block; font-size: 12px; color: var(--gris); letter-spacing: 0.12em; margin-bottom: 4px; }
  .casillas { display: grid; border-bottom: 1px solid var(--linea); }
  .casillas.c4 { grid-template-columns: repeat(4, 1fr); }
  .casillas.c3 { grid-template-columns: repeat(3, 1fr); }
  .casillas.c2 { grid-template-columns: repeat(2, 1fr); }
  .casillas > div { padding: 10px 12px; border-right: 1px solid var(--linea); }
  .casillas > div:last-child { border-right: 0; }
  .casillas dt {
    font: 600 12.5px/1.2 Archivo, sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gris);
  }
  .casillas dd { font: 700 16px/1.3 "Courier Prime", monospace; margin-top: 4px; }

  /* Rubber stamp */
  .sello {
    position: absolute;
    display: grid;
    place-items: center;
    width: 172px;
    height: 172px;
    border: 5px solid var(--rojo);
    border-radius: 50%;
    color: var(--rojo);
    text-align: center;
    font: 900 28px/1 Archivo, sans-serif;
    font-stretch: 70%;
    letter-spacing: 0.06em;
    mix-blend-mode: multiply;
    transform: rotate(-12deg);
    pointer-events: none;
    box-shadow: inset 0 0 0 4px var(--papel), inset 0 0 0 6px var(--rojo);
  }
  .sello small { display: block; font: 700 13px/1 "Courier Prime", monospace; letter-spacing: 0.1em; margin-top: 6px; }

  /* Red strike = pending */
  .tachon {
    position: absolute;
    left: -6px;
    right: -6px;
    top: 54%;
    height: 3px;
    background: var(--rojo);
    border-radius: 2px;
    transform-origin: left center;
  }

  /* Button */
  .btn {
    display: inline-block;
    background: var(--tinta);
    color: var(--papel);
    font: 800 19px/1.15 Archivo, sans-serif;
    font-stretch: 85%;
    letter-spacing: 0.02em;
    padding: 20px 28px;
    border-radius: 2px;
    text-decoration: none;
    box-shadow: 6px 6px 0 var(--calco);
    transition: transform 0.15s var(--casa), box-shadow 0.15s var(--casa);
  }
  .btn:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0 var(--calco); }
  .btn:active { transform: translate(4px, 4px); box-shadow: 2px 2px 0 var(--calco); }
  .cta { display: flex; flex-wrap: wrap; gap: 18px 26px; align-items: center; }
  .cta-nota { font: 700 15px/1.3 "Courier Prime", monospace; color: var(--gris); }
  .cta-nota a { color: var(--calco); }

  /* ---------- 2 · Hero ---------- */
  .hoja-hero { min-height: calc(100vh - 64px); display: flex; flex-direction: column; }
  .titular {
    margin-top: clamp(28px, 5vh, 52px);
    font: 900 clamp(64px, 11.5vw, 176px)/0.86 Archivo, sans-serif;
    font-stretch: 62%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
